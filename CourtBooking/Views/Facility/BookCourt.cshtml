@model CourtBooking.ViewModels.CourtAvailabilityViewModel
@using CourtBooking.Models
@{
    var fs   = ViewBag.FacilitySettings as FacilitySettings;
    var slug = ViewBag.Slug as string;
    ViewData["Title"] = $"Book {Model.Court.Name}";

    // ── Past-time detection (Philippine Standard Time = UTC+8) ──────────────
    var   localNow   = PhtClock.Now;
    var   today      = DateOnly.FromDateTime(localNow);
    bool  isPastDate = Model.Date < today;
    bool  isToday    = Model.Date == today;
    int   nowHour    = localNow.Hour;
    int   nowMinute  = localNow.Minute;
    // Grey out slots that start within the next 20 minutes (or are already past)
    bool SlotIsPast(int startHour) => isPastDate || (isToday && (startHour * 60 + 20) < (nowHour * 60 + nowMinute));

    string SportDefaultImage(string sport) => sport?.ToLower() switch {
        "tennis"       => "/images/sports/tennis.svg",
        "badminton"    => "/images/sports/badminton.svg",
        "basketball"   => "/images/sports/basketball.svg",
        "volleyball"   => "/images/sports/volleyball.svg",
        "football"     => "/images/sports/football.svg",
        "futsal"       => "/images/sports/futsal.svg",
        "swimming"     => "/images/sports/swimming.svg",
        "table tennis" => "/images/sports/table-tennis.svg",
        "billiards"    => "/images/sports/billiards.svg",
        "pickleball"   => "/images/sports/pickleball.svg",
        _              => "/images/sports/default.svg"
    };
}

<!-- Hero -->
<div class="cb-facility-hero">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0" style="font-size:.825rem;">
                <li class="breadcrumb-item">
                    <a href="/sportshub/@slug" style="color:var(--cb-text-3);text-decoration:none;">
                        <i class="bi bi-buildings me-1"></i>@(fs?.DisplayName ?? "Courts")
                    </a>
                </li>
                <li class="breadcrumb-item active" style="color:var(--cb-text-2);">@Model.Court.Name</li>
            </ol>
        </nav>
        <div class="d-flex align-items-start gap-3 flex-wrap">
            <div>
                <h1 class="mb-1 cb-fade-up" style="font-size:1.75rem;font-weight:800;letter-spacing:-0.03em;">
                    @Model.Court.Name
                </h1>
                <div class="d-flex flex-wrap gap-2 align-items-center cb-fade-up-delay-1">
                    <span class="badge" style="background:var(--cb-surface-3);color:var(--cb-text-2);">@Model.Court.SportType</span>
                    <span class="badge" style="background:var(--cb-blue-dim);color:var(--cb-blue);">
                        <i class="bi bi-@(Model.Court.IsIndoor ? "house" : "sun") me-1"></i>@(Model.Court.IsIndoor ? "Indoor" : "Outdoor")
                    </span>
                    @if (fs != null)
                    {
                        <span style="color:var(--cb-text-3);font-size:.8rem;">
                            <i class="bi bi-buildings me-1"></i>@fs.DisplayName
                        </span>
                    }
                </div>
                @if (fs != null && !string.IsNullOrWhiteSpace(fs.Address))
                {
                    <p class="mt-2 mb-0 cb-fade-up-delay-2" style="color:var(--cb-text-3);font-size:.8rem;">
                        <i class="bi bi-geo-alt me-1" style="color:var(--cb-lime);"></i><a href="https://maps.google.com/?q=@Uri.EscapeDataString(fs.Address)" target="_blank" rel="noopener noreferrer" style="color:inherit;">@fs.Address</a>
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="row g-4">

        <!-- ── Court Info Sidebar ─────────────────────────────────────── -->
        <div class="col-lg-4">

            <!-- Court image / placeholder -->
            <div class="card mb-3 cb-fade-up" style="overflow:hidden;">
                <img src="@(!string.IsNullOrWhiteSpace(Model.Court.ImageUrl) ? Model.Court.ImageUrl : SportDefaultImage(Model.Court.SportType))"
                     alt="@Model.Court.Name"
                     style="width:100%;height:220px;object-fit:cover;" />
                <div class="card-body p-4">
                    <h6 class="mb-3 fw-bold" style="font-size:.875rem;color:var(--cb-text-2);letter-spacing:.05em;">
                        COURT DETAILS
                    </h6>
                    @if (!string.IsNullOrWhiteSpace(Model.Court.Description))
                    {
                        <p style="color:var(--cb-text-3);font-size:.825rem;line-height:1.6;margin-bottom:1rem;">@Model.Court.Description</p>
                    }
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-center gap-2" style="font-size:.85rem;">
                            <i class="bi bi-tag" style="color:var(--cb-lime);width:16px;"></i>
                            <span style="color:var(--cb-text-3);">Sport</span>
                            <span class="ms-auto fw-semibold">@Model.Court.SportType</span>
                        </div>
                        <div class="d-flex align-items-center gap-2" style="font-size:.85rem;">
                            <i class="bi bi-house" style="color:var(--cb-lime);width:16px;"></i>
                            <span style="color:var(--cb-text-3);">Type</span>
                            <span class="ms-auto fw-semibold">@(Model.Court.IsIndoor ? "Indoor" : "Outdoor")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2" style="font-size:.85rem;">
                            <i class="bi bi-clock" style="color:var(--cb-lime);width:16px;"></i>
                            <span style="color:var(--cb-text-3);">Hours</span>
                            <span class="ms-auto fw-semibold">@TimeDisplay.HourRange(Model.Court.OpeningHour, Model.Court.ClosingHour)</span>
                        </div>
                        <hr style="margin:.5rem 0;" />
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-lightning-charge-fill" style="color:var(--cb-lime);width:16px;"></i>
                            <span style="color:var(--cb-text-3);font-size:.85rem;">Rate</span>
                            <span class="ms-auto fw-bold" style="font-size:1.1rem;color:var(--cb-lime);">
                                @if (Model.HasRateRange)
                                {
                                    @:₱@Model.RateRangeMin.ToString("N0")&ndash;@Model.RateRangeMax.ToString("N0")
                                }
                                else
                                {
                                    @:₱@Model.Court.PricePerHour.ToString("N0")
                                }
                                <span style="font-size:.75rem;font-weight:400;color:var(--cb-text-3);">/hr</span>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Date picker -->
            <div class="card cb-fade-up-delay-1">
                <div class="card-body p-3">
                    <h6 class="mb-3 fw-bold" style="font-size:.875rem;color:var(--cb-text-2);letter-spacing:.05em;">
                        <i class="bi bi-calendar3 me-2" style="color:var(--cb-lime);"></i>SELECT DATE
                    </h6>
                    <!-- Hidden form — submitted by JS when a day is picked -->
                    <form method="get" id="datePickerForm">
                        <input type="hidden" name="date" id="datePickerInput"
                               value="@Model.Date.ToString("yyyy-MM-dd")" />
                    </form>
                    <!-- Inline Flatpickr calendar renders here -->
                    <div id="calendarInline" class="cb-calendar-wrap"></div>
                    <div class="mt-3 p-2 rounded-2 text-center" style="background:var(--cb-surface-2);font-size:.8rem;color:var(--cb-text-2);">
                        <i class="bi bi-calendar-event me-1" style="color:var(--cb-lime);"></i>
                        <strong id="selectedDateLabel">@Model.Date.ToString("dddd, MMMM d, yyyy")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Availability Grid ──────────────────────────────────────── -->
        <div class="col-lg-8">
            <div class="card cb-fade-up-delay-1">
                <div class="card-header">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div>
                            <h5 class="mb-0" style="font-size:1rem;font-weight:700;">
                                <i class="bi bi-clock me-2" style="color:var(--cb-lime);"></i>Available Slots
                            </h5>
                            <p class="mb-0 mt-1" style="font-size:.78rem;color:var(--cb-text-3);">
                                Tap an available slot to start your booking
                            </p>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="badge" style="background:rgba(34,197,94,0.15);color:#4ade80;border:1px solid rgba(34,197,94,0.3);font-size:.72rem;padding:.4em .75em;">
                                <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:1px;"></i>Available
                            </span>
                            <span class="badge" style="background:rgba(239,68,68,0.12);color:#f87171;border:1px solid rgba(239,68,68,0.25);font-size:.72rem;padding:.4em .75em;">
                                <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:1px;"></i>Booked
                            </span>
                            @if (!Model.HasSlots && Model.OpenPlayHours.Any())
                            {
                                <span class="badge" style="background:rgba(148,163,184,0.15);color:#cbd5e1;border:1px solid rgba(148,163,184,0.3);font-size:.72rem;padding:.4em .75em;">
                                    <i class="bi bi-people me-1"></i>Open Play
                                </span>
                            }
                            @if (!Model.HasSlots && Model.BundleOnlyHours.Any())
                            {
                                <span class="badge" style="background:var(--cb-lime);color:#000;font-size:.72rem;padding:.4em .75em;">
                                    <i class="bi bi-box-seam me-1"></i>Bundle Only
                                </span>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (Model.HasSlots)
                    {
                        <div class="row g-3">
                            @foreach (var slot in Model.TimeSlots)
                            {
                                bool isUnavailable = Model.UnavailableSlotIds.Contains(slot.Id);
                                bool isPast        = SlotIsPast(slot.StartHour);
                                decimal price = Model.SlotPrices.TryGetValue(slot.Id, out var _p)
                                    ? _p
                                    : Model.Court.PricePerHour * slot.DurationHours;
                                <div class="col-sm-6 col-md-4">
                                    @if (isPast)
                                    {
                                        <div class="h-100 p-3 text-center rounded-3"
                                             style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.5;cursor:default;">
                                            <div class="fw-bold mb-1" style="font-size:.95rem;color:var(--cb-text-3);">@slot.TimeLabel</div>
                                            <div style="font-size:.75rem;color:var(--cb-text-3);">
                                                @slot.DurationHours hr@(slot.DurationHours != 1 ? "s" : "") &bull; ₱@price.ToString("N0")
                                            </div>
                                            <div class="mt-2">
                                                <span class="badge" style="background:var(--cb-surface-3);color:var(--cb-text-3);font-size:.72rem;">
                                                    <i class="bi bi-clock-history me-1"></i>Past
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    else if (isUnavailable)
                                    {
                                        <div class="slot-booked h-100 p-3 text-center rounded-3">
                                            <div class="fw-bold mb-1" style="font-size:.95rem;color:#f87171;">@slot.TimeLabel</div>
                                            <div style="font-size:.75rem;color:var(--cb-text-3);">
                                                @slot.DurationHours hr@(slot.DurationHours != 1 ? "s" : "") &bull; ₱@price.ToString("N0")
                                            </div>
                                            <div class="mt-2">
                                                <span class="badge" style="background:rgba(239,68,68,0.2);color:#f87171;font-size:.72rem;">
                                                    <i class="bi bi-x-circle me-1"></i>Booked
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-controller="Bookings" asp-action="Create"
                                           asp-route-courtId="@Model.Court.Id"
                                           asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                                           asp-route-startHour="@slot.StartHour"
                                           asp-route-endHour="@slot.EndHour"
                                           class="slot-available h-100 p-3 text-center rounded-3 d-block">
                                            <div class="fw-bold mb-1" style="font-size:.95rem;color:#4ade80;">@slot.TimeLabel</div>
                                            <div style="font-size:.75rem;color:var(--cb-text-3);">
                                                @slot.DurationHours hr@(slot.DurationHours != 1 ? "s" : "") &bull;
                                                <span style="color:var(--cb-lime);font-weight:600;">₱@price.ToString("N0")</span>
                                            </div>
                                            <div class="mt-2">
                                                <span class="badge" style="background:rgba(34,197,94,0.2);color:#4ade80;font-size:.72rem;">
                                                    <i class="bi bi-calendar-plus me-1"></i>Book
                                                </span>
                                            </div>
                                        </a>
                                    }
                                </div>
                            }
                        </div>

                        @if (Model.TimeSlots.All(s => Model.UnavailableSlotIds.Contains(s.Id)))
                        {
                            <div class="text-center py-4 mt-3" style="border-top:1px solid var(--cb-border);">
                                <i class="bi bi-calendar-x display-6 d-block mb-2" style="color:var(--cb-text-3);"></i>
                                <p style="color:var(--cb-text-3);font-size:.875rem;margin:0;">
                                    All slots are booked for this date. Try another day.
                                </p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="row g-2">
                            @for (int h = Model.Court.OpeningHour; h < Model.Court.ClosingHour; h++)
                            {
                                bool isBooked  = Model.BookedHours.Contains(h);
                                bool isPending = Model.PendingHours.Contains(h);
                                bool isBlocked = Model.BlockedHours.Contains(h);
                                bool isPast    = SlotIsPast(h);
                                bool isOpenPlay = Model.OpenPlayHours.Contains(h);
                                bool isBundleOnly = Model.BundleOnlyHours.TryGetValue(h, out var bundleMatch);
                                bool isOpenPlaySignup = Model.OpenPlaySignupInfo.TryGetValue(h, out var signupMatch);
                                var rate = Model.HourlyRates.TryGetValue(h, out var r) ? r : Model.Court.PricePerHour;
                                var timeLabel  = TimeDisplay.HourRange(h, h + 1);

                                @* An open (not booked/blocked/past) bundle-only run is rendered once as a single
                                   full-width block spanning its whole hour range, instead of one tile per hour. *@
                                if (!isPast && !isBooked && !isPending && !isBlocked && isBundleOnly)
                                {
                                    var bundleLabel = TimeDisplay.HourRange(bundleMatch.Block.StartHour, bundleMatch.Block.EndHour);
                                    <div class="col-12">
                                        <a asp-controller="BundleBookings" asp-action="Create"
                                           asp-route-bundleId="@bundleMatch.Bundle.Id"
                                                         asp-route-courtId="@Model.Court.Id"
                                           asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                                           asp-route-startHour="@bundleMatch.Block.StartHour"
                                           asp-route-endHour="@bundleMatch.Block.EndHour"
                                           class="p-2 text-center rounded-3 d-block text-decoration-none" style="background:var(--cb-lime);">
                                            <div style="font-size:.85rem;color:#000;font-weight:700;">@bundleLabel</div>
                                            <div style="font-size:.7rem;color:#000;margin-top:2px;font-weight:600;">
                                                <i class="bi bi-box-seam me-1"></i>Bundle Only
                                            </div>
                                        </a>
                                    </div>
                                    h = bundleMatch.Block.EndHour - 1;
                                    continue;
                                }

                                if (!isPast && !isBooked && !isPending && !isBlocked && isOpenPlaySignup && h == signupMatch.Block.StartHour)
                                {
                                    var runEndHour = signupMatch.Block.EndHour;
                                    var runSpotsRemaining = signupMatch.SpotsRemaining;
                                    var runPrice = signupMatch.Block.PricePerHead;
                                    var runDescription = signupMatch.Block.Description;

                                    while (Model.OpenPlaySignupInfo.TryGetValue(runEndHour, out var nextSignup)
                                           && nextSignup.Block.StartHour == runEndHour
                                           && nextSignup.Block.PricePerHead == runPrice
                                           && nextSignup.Block.Description == runDescription
                                           && nextSignup.SpotsRemaining == runSpotsRemaining)
                                    {
                                        runEndHour = nextSignup.Block.EndHour;
                                    }

                                    var openPlayLabel = TimeDisplay.HourRange(signupMatch.Block.StartHour, runEndHour);
                                    bool isUnlimited = runSpotsRemaining == int.MaxValue;
                                    <div class="col-12">
                                        @if (isUnlimited || runSpotsRemaining > 0)
                                        {
                                            <a asp-controller="OpenPlaySignups" asp-action="Create"
                                               asp-route-courtId="@Model.Court.Id"
                                               asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                                               asp-route-startHour="@signupMatch.Block.StartHour"
                                               asp-route-endHour="@runEndHour"
                                               class="p-2 text-center rounded-3 d-block text-decoration-none"
                                               style="background:var(--cb-surface-2);border:1px solid var(--cb-lime);">
                                                <div style="font-size:.8rem;color:var(--cb-text-1);font-weight:600;">@openPlayLabel</div>
                                                <div style="font-size:.7rem;color:var(--cb-lime);margin-top:2px;font-weight:600;">
                                                    <i class="bi bi-people me-1"></i>Open Play
                                                    @if (runPrice.HasValue)
                                                    {
                                                        <text>&middot; ₱@runPrice.Value.ToString("N0")/head</text>
                                                    }
                                                    @if (!isUnlimited)
                                                    {
                                                        <text>&middot; @runSpotsRemaining spot@(runSpotsRemaining != 1 ? "s" : "") left</text>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(runDescription))
                                                {
                                                    <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@runDescription</div>
                                                }
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="p-2 text-center rounded-3" style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.75;">
                                                <div style="font-size:.8rem;color:var(--cb-text-2);font-weight:600;">@openPlayLabel</div>
                                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">Open Play — Full</div>
                                                @if (!string.IsNullOrWhiteSpace(runDescription))
                                                {
                                                    <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@runDescription</div>
                                                }
                                            </div>
                                        }
                                    </div>
                                    h = runEndHour - 1;
                                    continue;
                                }

                                if (!isPast && !isBooked && !isPending && !isBlocked && isOpenPlaySignup)
                                {
                                    continue;
                                }

                                <div class="col-6 col-sm-4 col-md-3">
                                    @if (isPast)
                                    {
                                        <div class="p-2 text-center rounded-3"
                                             style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.45;cursor:default;">
                                            <div style="font-size:.8rem;color:var(--cb-text-3);font-weight:600;">@timeLabel</div>
                                            <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">
                                                <i class="bi bi-clock-history me-1"></i>Past
                                            </div>
                                        </div>
                                    }
                                    else if (isBooked)
                                    {
                                        <div class="slot-booked p-2 text-center rounded-3" style="opacity:.7;">
                                            <div style="font-size:.8rem;color:#f87171;font-weight:600;">@timeLabel</div>
                                            <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">Booked@(isOpenPlay ? " • Open Play" : "")</div>
                                        </div>
                                    }
                                    else if (isPending)
                                    {
                                        <div class="p-2 text-center rounded-3" style="background:rgba(234,179,8,0.12);border:1px solid rgba(234,179,8,0.4);opacity:.85;cursor:default;">
                                            <div style="font-size:.8rem;color:#eab308;font-weight:600;">@timeLabel</div>
                                            <div style="font-size:.7rem;color:#ca8a04;margin-top:2px;"><i class="bi bi-hourglass-split me-1"></i>Pending</div>
                                        </div>
                                    }
                                    else if (isBlocked)
                                    {
                                        var blockReason = Model.BlockReasons.TryGetValue(h, out var _br) ? _br : null;
                                        <div class="p-2 text-center rounded-3"
                                             style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.55;cursor:default;">
                                            <div style="font-size:.8rem;color:var(--cb-text-3);font-weight:600;">@timeLabel</div>
                                            <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@(blockReason ?? "Unavailable")</div>
                                        </div>
                                    }
                                    else if (isOpenPlaySignup && signupMatch.SpotsRemaining > 0)
                                    {
                                        <a asp-controller="OpenPlaySignups" asp-action="Create"
                                           asp-route-courtId="@Model.Court.Id"
                                           asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                                           asp-route-startHour="@signupMatch.Block.StartHour"
                                           asp-route-endHour="@signupMatch.Block.EndHour"
                                           class="p-2 text-center rounded-3 d-block text-decoration-none"
                                           style="background:var(--cb-surface-2);border:1px solid var(--cb-lime);">
                                            <div style="font-size:.8rem;color:var(--cb-text-1);font-weight:600;">@timeLabel</div>
                                            <div style="font-size:.7rem;color:var(--cb-lime);margin-top:2px;font-weight:600;">
                                                <i class="bi bi-people me-1"></i>@signupMatch.SpotsRemaining spot@(signupMatch.SpotsRemaining != 1 ? "s" : "") left
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(signupMatch.Block.Description))
                                            {
                                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@signupMatch.Block.Description</div>
                                            }
                                        </a>
                                    }
                                    else if (isOpenPlaySignup)
                                    {
                                        <div class="p-2 text-center rounded-3"
                                             style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.55;cursor:default;">
                                            <div style="font-size:.8rem;color:var(--cb-text-3);font-weight:600;">@timeLabel</div>
                                            <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">
                                                <i class="bi bi-people-fill me-1"></i>Full
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(signupMatch.Block.Description))
                                            {
                                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@signupMatch.Block.Description</div>
                                            }
                                        </div>
                                    }
                                    else if (isOpenPlay)
                                    {
                                        <div class="p-2 text-center rounded-3"
                                             style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.75;cursor:default;">
                                            <div style="font-size:.8rem;color:var(--cb-text-2);font-weight:600;">@timeLabel</div>
                                            <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">
                                                <i class="bi bi-people me-1"></i>Open Play
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-controller="Bookings" asp-action="Create"
                                           asp-route-courtId="@Model.Court.Id"
                                           asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                                           asp-route-startHour="@h"
                                           class="slot-available p-2 text-center rounded-3 d-block">
                                            <div style="font-size:.8rem;color:#4ade80;font-weight:600;">@timeLabel</div>
                                            <div style="font-size:.7rem;color:var(--cb-lime);margin-top:2px;font-weight:600;">
                                                ₱@rate.ToString("N0")
                                            </div>
                                        </a>
                                    }
                                </div>
                            }
                        </div>

                        @if (!Model.AvailableHours.Any())
                        {
                            <div class="text-center py-4 mt-3" style="border-top:1px solid var(--cb-border);">
                                <i class="bi bi-calendar-x display-6 d-block mb-2" style="color:var(--cb-text-3);"></i>
                                <p style="color:var(--cb-text-3);font-size:.875rem;margin:0;">
                                    All slots are booked for this date. Try another day.
                                </p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    static string SportIcon(string sport) => sport?.ToLower() switch
    {
        "tennis"       => "bi-dribbble",
        "badminton"    => "bi-feather",
        "basketball"   => "bi-bullseye",
        "volleyball"   => "bi-circle-fill",
        "football"     => "bi-globe2",
        "futsal"       => "bi-lightning-charge-fill",
        "swimming"     => "bi-water",
        "table tennis" => "bi-record-circle",
        "billiards"    => "bi-circle",
        "pickleball"   => "bi-record2-fill",
        _              => "bi-trophy-fill"
    };
}

@section Scripts {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css" />
<style>
    /* ── Flatpickr inline calendar — CourtBook dark theme overrides ── */

    /* Stretch to fill the card and blend backgrounds */
    .cb-calendar-wrap .flatpickr-calendar {
        background: var(--cb-surface-2) !important;
        box-shadow: none !important;
        border: none !important;
        width: 100% !important;
    }
    .cb-calendar-wrap .flatpickr-months {
        background: var(--cb-surface-2) !important;
        border-radius: 8px 8px 0 0;
    }
    .cb-calendar-wrap .flatpickr-innerContainer {
        background: var(--cb-surface-2) !important;
        border-radius: 0 0 8px 8px;
    }
    .cb-calendar-wrap .flatpickr-weekdays,
    .cb-calendar-wrap span.flatpickr-weekday {
        background: var(--cb-surface-2) !important;
        color: var(--cb-text-3) !important;
        font-size: .72rem;
        letter-spacing: .04em;
    }

    /* Full-width day grid */
    .cb-calendar-wrap .flatpickr-days   { width: 100% !important; border: none !important; }
    .cb-calendar-wrap .dayContainer     { width: 100% !important; min-width: unset !important; max-width: unset !important; }

    /* Individual day cells */
    .cb-calendar-wrap .flatpickr-day {
        border-radius: 8px !important;
        color: var(--cb-text-2) !important;
        max-width: 36px;
        height: 36px;
        line-height: 34px;
    }
    .cb-calendar-wrap .flatpickr-day:hover:not(.flatpickr-disabled):not(.prevMonthDay):not(.nextMonthDay) {
        background: var(--cb-surface-3) !important;
        border-color: var(--cb-border) !important;
        color: var(--cb-text-1) !important;
    }

    /* Selected day — lime fill */
    .cb-calendar-wrap .flatpickr-day.selected,
    .cb-calendar-wrap .flatpickr-day.selected:hover,
    .cb-calendar-wrap .flatpickr-day.startRange,
    .cb-calendar-wrap .flatpickr-day.endRange {
        background: var(--cb-lime) !important;
        border-color:  var(--cb-lime) !important;
        color: #0a0a0a !important;
        font-weight: 700 !important;
    }

    /* Today — lime outline */
    .cb-calendar-wrap .flatpickr-day.today:not(.selected) {
        border-color: var(--cb-lime) !important;
        color: var(--cb-lime) !important;
        font-weight: 700 !important;
        background: transparent !important;
    }

    /* Disabled / out-of-month days */
    .cb-calendar-wrap .flatpickr-day.flatpickr-disabled,
    .cb-calendar-wrap .flatpickr-day.prevMonthDay,
    .cb-calendar-wrap .flatpickr-day.nextMonthDay {
        color: var(--cb-text-3) !important;
        opacity: .3 !important;
    }

    /* Month/year header text */
    .cb-calendar-wrap .flatpickr-current-month input.cur-year,
    .cb-calendar-wrap .flatpickr-current-month .flatpickr-monthDropdown-months,
    .cb-calendar-wrap .flatpickr-current-month span.cur-month {
        color: var(--cb-text-1) !important;
    }
    .cb-calendar-wrap .flatpickr-monthDropdown-months {
        background: var(--cb-surface-2) !important;
    }

    /* Prev/next arrows */
    .cb-calendar-wrap .flatpickr-prev-month svg,
    .cb-calendar-wrap .flatpickr-next-month svg { fill: var(--cb-text-2) !important; }
    .cb-calendar-wrap .flatpickr-prev-month:hover svg,
    .cb-calendar-wrap .flatpickr-next-month:hover svg { fill: var(--cb-lime) !important; }

    /* Year stepper arrows */
    .cb-calendar-wrap .numInputWrapper span { border-color: var(--cb-border) !important; }
    .cb-calendar-wrap .numInputWrapper span:after { border-top-color: var(--cb-text-2) !important; border-bottom-color: var(--cb-text-2) !important; }
    .cb-calendar-wrap .numInputWrapper:hover { background: transparent !important; }
</style>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
(function () {
    var minDate = "@PhtClock.Today.ToString("yyyy-MM-dd")";
    var maxDate = "@PhtClock.Today.AddDays(30).ToString("yyyy-MM-dd")";
    var current = "@Model.Date.ToString("yyyy-MM-dd")";

    flatpickr("#calendarInline", {
        inline:      true,
        defaultDate: current,
        minDate:     minDate,
        maxDate:     maxDate,
        onChange: function (selectedDates, dateStr) {
            document.getElementById("datePickerInput").value = dateStr;
            document.getElementById("datePickerForm").submit();
        }
    });
})();
</script>
}
