@model string
@* Floating multi-court cart widget. Included only on facility browsing/booking pages and the
   staff walk-in pages — not the global _Layout — so it never shows up on Admin/Account pages.
   Populated entirely client-side from localStorage by wwwroot/js/cart.js.

   Pass a checkout URL as the model when the target page is fixed and doesn't depend on the
   cart's own facility slug (e.g. staff's own walk-in cart form). Omit it (pass null) on the
   public customer pages, where cart.js derives "/Cart/Checkout?slug=..." from the cart itself. *@
<a id="cbCartLink" href="@(Model ?? "#")" data-static-url="@(Model != null ? "true" : "false")"
   class="cb-cart-widget d-none d-md-flex align-items-center gap-2 shadow"
   style="position:fixed;bottom:20px;right:20px;z-index:1060;background:var(--cb-lime);color:#000;
          padding:12px 18px;border-radius:999px;text-decoration:none;font-weight:600;font-size:.9rem;">
    <i class="bi bi-cart3"></i>
    <span>Cart</span>
    <span id="cbCartTotal">₱0</span>
    <span id="cbCartBadge"
          style="display:none;background:#000;color:var(--cb-lime);border-radius:999px;min-width:20px;
                 height:20px;padding:0 6px;font-size:.75rem;align-items:center;justify-content:center;">0</span>
</a>
<script src="~/js/cart.js" asp-append-version="true"></script>
