@model CourtBooking.ViewModels.CourtAvailabilityViewModel
@using CourtBooking.Models
@using CourtBooking.Helpers
@{
    var fs   = ViewBag.FacilitySettings as FacilitySettings;
    var slug = ViewBag.Slug as string;

    // ── Past-time detection (Philippine Standard Time = UTC+8) ──────────────
    var   localNow   = PhtClock.Now;
    var   today      = DateOnly.FromDateTime(localNow);
    bool  isPastDate = Model.Date < today;
    bool  isToday    = Model.Date == today;
    int   nowHour    = localNow.Hour;
    int   nowMinute  = localNow.Minute;
    // Grey out slots that start within the next 20 minutes (or are already past)
    bool SlotIsPast(int startHour) => isPastDate || (isToday && (startHour * 60 + 20) < (nowHour * 60 + nowMinute));
}
<div class="card cb-fade-up-delay-1">
    <div class="card-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h5 class="mb-0" style="font-size:1rem;font-weight:700;">
                    <i class="bi bi-clock me-2" style="color:var(--cb-lime);"></i>Available Slots
                </h5>
                <p class="mb-0 mt-1" style="font-size:.78rem;color:var(--cb-text-3);">
                    Tap an available slot to start your booking
                </p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge" style="background:rgba(34,197,94,0.15);color:#4ade80;border:1px solid rgba(34,197,94,0.3);font-size:.72rem;padding:.4em .75em;">
                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:1px;"></i>Available
                </span>
                <span class="badge" style="background:rgba(239,68,68,0.12);color:#f87171;border:1px solid rgba(239,68,68,0.25);font-size:.72rem;padding:.4em .75em;">
                    <i class="bi bi-circle-fill me-1" style="font-size:.45rem;vertical-align:1px;"></i>Booked
                </span>
                @if (!Model.HasSlots && Model.OpenPlayHours.Any())
                {
                    <span class="badge" style="background:rgba(148,163,184,0.15);color:#cbd5e1;border:1px solid rgba(148,163,184,0.3);font-size:.72rem;padding:.4em .75em;">
                        <i class="bi bi-people me-1"></i>Open Play
                    </span>
                }
                @if (!Model.HasSlots && Model.BundleOnlyHours.Any())
                {
                    <span class="badge" style="background:var(--cb-lime);color:#000;font-size:.72rem;padding:.4em .75em;">
                        <i class="bi bi-box-seam me-1"></i>Bundle Only
                    </span>
                }
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        @if (Model.HasSlots)
        {
            <div class="row g-3">
                @foreach (var slot in Model.TimeSlots)
                {
                    bool isUnavailable = Model.UnavailableSlotIds.Contains(slot.Id);
                    bool isPast        = SlotIsPast(slot.StartHour);
                    decimal price = Model.SlotPrices.TryGetValue(slot.Id, out var _p)
                        ? _p
                        : Model.Court.PricePerHour * slot.DurationHours;
                    <div class="col-sm-6 col-md-4">
                        @if (isPast)
                        {
                            <div class="h-100 p-3 text-center rounded-3"
                                 style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.5;cursor:default;">
                                <div class="fw-bold mb-1" style="font-size:.95rem;color:var(--cb-text-3);">@slot.TimeLabel</div>
                                <div style="font-size:.75rem;color:var(--cb-text-3);">
                                    @slot.DurationHours hr@(slot.DurationHours != 1 ? "s" : "") &bull; ₱@price.ToString("N0")
                                </div>
                                <div class="mt-2">
                                    <span class="badge" style="background:var(--cb-surface-3);color:var(--cb-text-3);font-size:.72rem;">
                                        <i class="bi bi-clock-history me-1"></i>Past
                                    </span>
                                </div>
                            </div>
                        }
                        else if (isUnavailable)
                        {
                            <div class="slot-booked h-100 p-3 text-center rounded-3">
                                <div class="fw-bold mb-1" style="font-size:.95rem;color:#f87171;">@slot.TimeLabel</div>
                                <div style="font-size:.75rem;color:var(--cb-text-3);">
                                    @slot.DurationHours hr@(slot.DurationHours != 1 ? "s" : "") &bull; ₱@price.ToString("N0")
                                </div>
                                <div class="mt-2">
                                    <span class="badge" style="background:rgba(239,68,68,0.2);color:#f87171;font-size:.72rem;">
                                        <i class="bi bi-x-circle me-1"></i>Booked
                                    </span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="position-relative h-100">
                                <a asp-controller="Bookings" asp-action="Create"
                                   asp-route-courtId="@Model.Court.Id"
                                   asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                                   asp-route-startHour="@slot.StartHour"
                                   asp-route-endHour="@slot.EndHour"
                                   class="slot-available h-100 p-3 text-center rounded-3 d-block">
                                    <div class="fw-bold mb-1" style="font-size:.95rem;color:#4ade80;">@slot.TimeLabel</div>
                                    <div style="font-size:.75rem;color:var(--cb-text-3);">
                                        @slot.DurationHours hr@(slot.DurationHours != 1 ? "s" : "") &bull;
                                        <span style="color:var(--cb-lime);font-weight:600;">₱@price.ToString("N0")</span>
                                    </div>
                                    <div class="mt-2">
                                        <span class="badge" style="background:rgba(34,197,94,0.2);color:#4ade80;font-size:.72rem;">
                                            <i class="bi bi-calendar-plus me-1"></i>Book
                                        </span>
                                    </div>
                                </a>
                                <button type="button" class="cb-add-to-cart btn btn-sm p-0"
                                        title="Add to cart — book with other slots together"
                                        data-court-id="@Model.Court.Id" data-court-name="@Model.Court.Name"
                                        data-owner-id="@fs?.OwnerId" data-facility-slug="@slug" data-facility-name="@fs?.FacilityName"
                                        data-date="@Model.Date.ToString("yyyy-MM-dd")" data-start-hour="@slot.StartHour" data-end-hour="@slot.EndHour"
                                        data-price="@price"
                                        style="position:absolute;top:6px;right:6px;width:24px;height:24px;border-radius:50%;
                                               background:rgba(0,0,0,.55);color:#fff;line-height:1;z-index:2;">
                                    <i class="bi bi-plus-lg" style="font-size:.7rem;"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (Model.TimeSlots.All(s => Model.UnavailableSlotIds.Contains(s.Id)))
            {
                <div class="text-center py-4 mt-3" style="border-top:1px solid var(--cb-border);">
                    <i class="bi bi-calendar-x display-6 d-block mb-2" style="color:var(--cb-text-3);"></i>
                    <p style="color:var(--cb-text-3);font-size:.875rem;margin:0;">
                        All slots are booked for this date. Try another day.
                    </p>
                </div>
            }
        }
        else
        {
            <div class="row g-2">
                @for (int h = Model.Court.OpeningHour; h < Model.Court.ClosingHour; h++)
                {
                    bool isBooked  = Model.BookedHours.Contains(h);
                    bool isPending = Model.PendingHours.Contains(h);
                    bool isBlocked = Model.BlockedHours.Contains(h);
                    bool isPast    = SlotIsPast(h);
                    bool isOpenPlay = Model.OpenPlayHours.Contains(h);
                    bool isBundleOnly = Model.BundleOnlyHours.TryGetValue(h, out var bundleMatch);
                    bool isPendingBundle = Model.PendingBundleWindows.TryGetValue(h, out var pendingBundle);
                    bool isOpenPlaySignup = Model.OpenPlaySignupInfo.TryGetValue(h, out var signupMatch);
                    var rate = Model.HourlyRates.TryGetValue(h, out var r) ? r : Model.Court.PricePerHour;
                    var timeLabel  = TimeDisplay.HourRange(h, h + 1);

                    if (!isPast && !isBooked && !isBlocked && isPendingBundle)
                    {
                        var bundleEndHour = pendingBundle.EndTime == TimeOnly.MinValue ? 24 : pendingBundle.EndTime.Hour;
                        var pendingLabel = TimeDisplay.HourRange(pendingBundle.StartTime.Hour, bundleEndHour);
                        <div class="col-12">
                            <div class="p-2 text-center rounded-3" style="background:rgba(234,179,8,0.12);border:1px solid rgba(234,179,8,0.4);opacity:.85;cursor:default;">
                                <div style="font-size:.85rem;color:#eab308;font-weight:700;">@pendingLabel</div>
                                <div style="font-size:.7rem;color:#ca8a04;margin-top:2px;"><i class="bi bi-box-seam me-1"></i>Bundle Pending</div>
                                @if (pendingBundle.CourtBundle is not null)
                                {
                                    <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@pendingBundle.CourtBundle.Name</div>
                                }
                            </div>
                        </div>
                        h = bundleEndHour - 1;
                        continue;
                    }

                    @* An open (not booked/blocked/past) bundle-only run is rendered once as a single
                       full-width block spanning its whole hour range, instead of one tile per hour. *@
                    if (!isPast && !isBooked && !isPending && !isBlocked && isBundleOnly)
                    {
                        var blockStart = bundleMatch.Block.StartHour;
                        var blockEnd   = bundleMatch.Block.EndHour;
                        // BundleBookingsController.Create requires an exact match against the block's
                        // own bounds — if any hour inside it is booked/pending/blocked elsewhere, the
                        // whole window can't be sold as a bundle, not just that one hour.
                        bool wholeBlockFree = true;
                        for (int bh = blockStart; bh < blockEnd; bh++)
                        {
                            if (Model.BookedHours.Contains(bh) || Model.PendingHours.Contains(bh) || Model.BlockedHours.Contains(bh))
                            {
                                wholeBlockFree = false;
                                break;
                            }
                        }

                        if (wholeBlockFree && h == blockStart)
                        {
                            var bundleLabel = TimeDisplay.HourRange(blockStart, blockEnd);
                            <div class="col-12">
                                <a asp-controller="BundleBookings" asp-action="Create"
                                   asp-route-bundleId="@bundleMatch.Bundle.Id"
                                                 asp-route-courtId="@Model.Court.Id"
                                   asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                                   asp-route-startHour="@blockStart"
                                   asp-route-endHour="@blockEnd"
                                   class="p-2 text-center rounded-3 d-block text-decoration-none" style="background:var(--cb-lime);">
                                    <div style="font-size:.85rem;color:#000;font-weight:700;">@bundleLabel</div>
                                    <div style="font-size:.7rem;color:#000;margin-top:2px;font-weight:600;">
                                        <i class="bi bi-box-seam me-1"></i>Bundle Only
                                    </div>
                                </a>
                            </div>
                            h = blockEnd - 1;
                            continue;
                        }

                        // Part of this window is already taken elsewhere — merge the remaining free
                        // hours into one disabled placeholder instead of a misleading clickable bar,
                        // or letting them fall through to an individually-bookable tile (bundle-only
                        // hours are never sold individually).
                        var runEnd = h + 1;
                        while (runEnd < blockEnd
                               && !Model.BookedHours.Contains(runEnd) && !Model.PendingHours.Contains(runEnd) && !Model.BlockedHours.Contains(runEnd))
                        {
                            runEnd++;
                        }
                        var placeholderLabel = TimeDisplay.HourRange(h, runEnd);
                        <div class="col-12">
                            <div class="p-2 text-center rounded-3"
                                 style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.6;cursor:default;">
                                <div style="font-size:.85rem;color:var(--cb-text-2);font-weight:700;">@placeholderLabel</div>
                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;font-weight:600;">
                                    <i class="bi bi-box-seam me-1"></i>Bundle Only &bull; unavailable (window partially booked)
                                </div>
                            </div>
                        </div>
                        h = runEnd - 1;
                        continue;
                    }

                    if (!isPast && !isBooked && !isPending && !isBlocked && !isPendingBundle && isOpenPlaySignup && h == signupMatch.Block.StartHour)
                    {
                        var runEndHour = signupMatch.Block.EndHour;
                        var runSpotsRemaining = signupMatch.SpotsRemaining;
                        var runPrice = signupMatch.Block.PricePerHead;
                        var runDescription = signupMatch.Block.Description;

                        while (Model.OpenPlaySignupInfo.TryGetValue(runEndHour, out var nextSignup)
                               && nextSignup.Block.StartHour == runEndHour
                               && nextSignup.Block.PricePerHead == runPrice
                               && nextSignup.Block.Description == runDescription
                               && nextSignup.SpotsRemaining == runSpotsRemaining)
                        {
                            runEndHour = nextSignup.Block.EndHour;
                        }

                        var openPlayLabel = TimeDisplay.HourRange(signupMatch.Block.StartHour, runEndHour);
                        bool isUnlimited = runSpotsRemaining == int.MaxValue;
                        <div class="col-12">
                            @if (isUnlimited || runSpotsRemaining > 0)
                            {
                                <a asp-controller="OpenPlaySignups" asp-action="Create"
                                   asp-route-courtId="@Model.Court.Id"
                                   asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                                   asp-route-startHour="@signupMatch.Block.StartHour"
                                   asp-route-endHour="@runEndHour"
                                   class="p-2 text-center rounded-3 d-block text-decoration-none"
                                   style="background:var(--cb-surface-2);border:1px solid var(--cb-lime);">
                                    <div style="font-size:.8rem;color:var(--cb-text-1);font-weight:600;">@openPlayLabel</div>
                                    <div style="font-size:.7rem;color:var(--cb-lime);margin-top:2px;font-weight:600;">
                                        <i class="bi bi-people me-1"></i>Open Play
                                        @if (runPrice.HasValue)
                                        {
                                            <text>&middot; ₱@runPrice.Value.ToString("N0")/head</text>
                                        }
                                        @if (!isUnlimited)
                                        {
                                            <text>&middot; @runSpotsRemaining spot@(runSpotsRemaining != 1 ? "s" : "") left</text>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(runDescription))
                                    {
                                        <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@runDescription</div>
                                    }
                                </a>
                            }
                            else
                            {
                                <div class="p-2 text-center rounded-3" style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.75;">
                                    <div style="font-size:.8rem;color:var(--cb-text-2);font-weight:600;">@openPlayLabel</div>
                                    <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">Open Play — Full</div>
                                    @if (!string.IsNullOrWhiteSpace(runDescription))
                                    {
                                        <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@runDescription</div>
                                    }
                                </div>
                            }
                        </div>
                        h = runEndHour - 1;
                        continue;
                    }

                    if (!isPast && !isBooked && !isPending && !isBlocked && !isPendingBundle && isOpenPlaySignup)
                    {
                        continue;
                    }

                    <div class="col-6 col-sm-4 col-md-3">
                        @if (isPast)
                        {
                            <div class="p-2 text-center rounded-3"
                                 style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.45;cursor:default;">
                                <div style="font-size:.8rem;color:var(--cb-text-3);font-weight:600;">@timeLabel</div>
                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">
                                    <i class="bi bi-clock-history me-1"></i>Past
                                </div>
                            </div>
                        }
                        else if (isBooked)
                        {
                            <div class="slot-booked p-2 text-center rounded-3" style="opacity:.7;">
                                <div style="font-size:.8rem;color:#f87171;font-weight:600;">@timeLabel</div>
                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">Booked@(isOpenPlay ? " • Open Play" : "")</div>
                            </div>
                        }
                        else if (isPending)
                        {
                            <div class="p-2 text-center rounded-3" style="background:rgba(234,179,8,0.12);border:1px solid rgba(234,179,8,0.4);opacity:.85;cursor:default;">
                                <div style="font-size:.8rem;color:#eab308;font-weight:600;">@timeLabel</div>
                                <div style="font-size:.7rem;color:#ca8a04;margin-top:2px;"><i class="bi bi-hourglass-split me-1"></i>Pending</div>
                            </div>
                        }
                        else if (isBlocked)
                        {
                            var blockReason = Model.BlockReasons.TryGetValue(h, out var _br) ? _br : null;
                            <div class="p-2 text-center rounded-3"
                                 style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.55;cursor:default;">
                                <div style="font-size:.8rem;color:var(--cb-text-3);font-weight:600;">@timeLabel</div>
                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@(blockReason ?? "Unavailable")</div>
                                @if (isBundleOnly)
                                {
                                    var bundleWindowLabel = TimeDisplay.HourRange(bundleMatch.Block.StartHour, bundleMatch.Block.EndHour);
                                    <div style="font-size:.65rem;color:var(--cb-text-3);margin-top:2px;">
                                        <i class="bi bi-box-seam me-1"></i>Blocks @bundleWindowLabel bundle
                                    </div>
                                }
                            </div>
                        }
                        else if (isOpenPlaySignup && signupMatch.SpotsRemaining > 0)
                        {
                            <a asp-controller="OpenPlaySignups" asp-action="Create"
                               asp-route-courtId="@Model.Court.Id"
                               asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                               asp-route-startHour="@signupMatch.Block.StartHour"
                               asp-route-endHour="@signupMatch.Block.EndHour"
                               class="p-2 text-center rounded-3 d-block text-decoration-none"
                               style="background:var(--cb-surface-2);border:1px solid var(--cb-lime);">
                                <div style="font-size:.8rem;color:var(--cb-text-1);font-weight:600;">@timeLabel</div>
                                <div style="font-size:.7rem;color:var(--cb-lime);margin-top:2px;font-weight:600;">
                                    <i class="bi bi-people me-1"></i>@signupMatch.SpotsRemaining spot@(signupMatch.SpotsRemaining != 1 ? "s" : "") left
                                </div>
                                @if (!string.IsNullOrWhiteSpace(signupMatch.Block.Description))
                                {
                                    <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@signupMatch.Block.Description</div>
                                }
                            </a>
                        }
                        else if (isOpenPlaySignup)
                        {
                            <div class="p-2 text-center rounded-3"
                                 style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.55;cursor:default;">
                                <div style="font-size:.8rem;color:var(--cb-text-3);font-weight:600;">@timeLabel</div>
                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">
                                    <i class="bi bi-people-fill me-1"></i>Full
                                </div>
                                @if (!string.IsNullOrWhiteSpace(signupMatch.Block.Description))
                                {
                                    <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@signupMatch.Block.Description</div>
                                }
                            </div>
                        }
                        else if (isOpenPlay)
                        {
                            <div class="p-2 text-center rounded-3"
                                 style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.75;cursor:default;">
                                <div style="font-size:.8rem;color:var(--cb-text-2);font-weight:600;">@timeLabel</div>
                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">
                                    <i class="bi bi-people me-1"></i>Open Play
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="position-relative h-100">
                                <a asp-controller="Bookings" asp-action="Create"
                                   asp-route-courtId="@Model.Court.Id"
                                   asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                                   asp-route-startHour="@h"
                                   class="slot-available p-2 text-center rounded-3 d-block">
                                    <div style="font-size:.8rem;color:#4ade80;font-weight:600;">@timeLabel</div>
                                    <div style="font-size:.7rem;color:var(--cb-lime);margin-top:2px;font-weight:600;">
                                        ₱@rate.ToString("N0")
                                    </div>
                                </a>
                                <button type="button" class="cb-add-to-cart btn btn-sm p-0"
                                        title="Add to cart — book with other slots together"
                                        data-court-id="@Model.Court.Id" data-court-name="@Model.Court.Name"
                                        data-owner-id="@fs?.OwnerId" data-facility-slug="@slug" data-facility-name="@fs?.FacilityName"
                                        data-date="@Model.Date.ToString("yyyy-MM-dd")" data-start-hour="@h" data-end-hour="@(h + 1)"
                                        data-price="@rate"
                                        style="position:absolute;top:4px;right:4px;width:20px;height:20px;border-radius:50%;
                                               background:rgba(0,0,0,.55);color:#fff;line-height:1;z-index:2;">
                                    <i class="bi bi-plus-lg" style="font-size:.6rem;"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>

            @if (!Model.AvailableHours.Any())
            {
                <div class="text-center py-4 mt-3" style="border-top:1px solid var(--cb-border);">
                    <i class="bi bi-calendar-x display-6 d-block mb-2" style="color:var(--cb-text-3);"></i>
                    <p style="color:var(--cb-text-3);font-size:.875rem;margin:0;">
                        All slots are booked for this date. Try another day.
                    </p>
                </div>
            }
        }
    </div>
</div>
