@model List<CourtBooking.ViewModels.CashLogRow>
@using CourtBooking.Models
@{
    ViewData["Title"] = "My Sales Log";
    DateOnly? from = ViewBag.From;
    DateOnly? to = ViewBag.To;
    decimal grandTotal = ViewBag.GrandTotal;
    decimal cashTotal = ViewBag.CashTotal;
    decimal digitalTotal = ViewBag.DigitalTotal;
    decimal pendingTotal = ViewBag.PendingTotal;
    int pendingCount = ViewBag.PendingCount;
    var byDay = Model.GroupBy(b => b.LoggedDate).OrderByDescending(g => g.Key);
}

<div class="cb-page-header">
    <div class="container">
        <h1 class="mb-1" style="font-size:1.75rem;">My Sales Log</h1>
        <p style="color:var(--cb-text-2);font-size:.9rem;margin:0;">Bookings, sign-ups, and add-on rentals you've logged &mdash; any payment method &mdash; for reconciliation.</p>
    </div>
</div>

<div class="container py-4">
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-sm-4">
                    <label class="form-label small fw-semibold">From</label>
                    <input type="date" name="from" class="form-control" value="@from?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label small fw-semibold">To</label>
                    <input type="date" name="to" class="form-control" value="@to?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-sm-4">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <div class="alert alert-primary d-flex justify-content-between align-items-center mb-0 h-100">
                <span><i class="bi bi-cash-stack me-2"></i><strong>Total for this range</strong></span>
                <span class="fs-5 fw-bold">₱@grandTotal.ToString("N0")</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="alert alert-success d-flex justify-content-between align-items-center mb-0 h-100">
                <span><i class="bi bi-cash me-2"></i>Cash</span>
                <span class="fs-5 fw-bold">₱@cashTotal.ToString("N0")</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="alert alert-info d-flex justify-content-between align-items-center mb-0 h-100">
                <span><i class="bi bi-phone me-2"></i>Digital (GCash/Maya/GoTyme)</span>
                <span class="fs-5 fw-bold">₱@digitalTotal.ToString("N0")</span>
            </div>
        </div>
    </div>

    @if (pendingCount > 0)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <span><i class="bi bi-hourglass-split me-2"></i><strong>@pendingCount</strong> payment@(pendingCount != 1 ? "s" : "") still awaiting owner confirmation &mdash; <strong>not</strong> included in the totals above</span>
            <span class="fs-6 fw-bold">₱@pendingTotal.ToString("N0")</span>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5" style="color:var(--cb-text-3);">No bookings logged for this range.</div>
    }
    else
    {
        foreach (var day in byDay)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>@day.Key.ToString("dddd, MMMM d, yyyy")</strong>
                    <span>₱@day.Where(b => b.Status != BookingStatus.Pending).Sum(b => b.TotalPrice).ToString("N0")</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr><th>Time</th><th>Court</th><th>Customer</th><th>Court Rental</th><th>Add-ons</th><th>Method</th><th>Status</th><th>Total Paid</th><th>Booked On</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var b in day.OrderBy(b => b.StartTime))
                            {
                                <tr class="@(b.Status == BookingStatus.Pending ? "table-warning" : "")">
                                    <td>@(b.IsAddOnOnly ? "—" : TimeDisplay.HourRange(b.StartTime.Hour, b.EndTime.Hour))</td>
                                    <td>
                                        @if (b.IsAddOnOnly)
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis" style="font-size:.65rem;">
                                                <i class="bi bi-bag-check"></i> Add-on Rental
                                            </span>
                                        }
                                        else
                                        {
                                            @b.CourtName
                                            @if (b.IsOpenPlay)
                                            {
                                                <span class="badge bg-primary-subtle text-primary-emphasis ms-1" style="font-size:.65rem;">
                                                    <i class="bi bi-people"></i> Open Play &middot; @b.SpotCount spot@(b.SpotCount != 1 ? "s" : "")
                                                </span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @b.CustomerName
                                        @if (b.PlayerNames is not null)
                                        {
                                            <div class="small text-muted">with @b.PlayerNames</div>
                                        }
                                    </td>
                                    <td>₱@b.CourtRental.ToString("N0")</td>
                                    <td>
                                        @if (b.AddOnsSummary is not null)
                                        {
                                            <span title="@b.AddOnsSummary">₱@b.AddOnsTotal.ToString("N0")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @{ var isCash = string.Equals(b.PaymentMethod, "Cash", StringComparison.OrdinalIgnoreCase); }
                                        <span class="badge @(isCash ? "bg-success-subtle text-success-emphasis" : "bg-info-subtle text-info-emphasis")" style="font-size:.7rem;">@(b.PaymentMethod ?? "Cash")</span>
                                    </td>
                                    <td>
                                        @if (b.Status == BookingStatus.Pending)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis" style="font-size:.7rem;"><i class="bi bi-hourglass-split"></i> Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success-emphasis" style="font-size:.7rem;">Confirmed</span>
                                        }
                                    </td>
                                    <td>₱@b.TotalPrice.ToString("N0")</td>
                                    <td class="text-muted small text-nowrap">@b.CreatedAt.AddHours(8).ToString("MMM d, yyyy h:mm tt")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>
