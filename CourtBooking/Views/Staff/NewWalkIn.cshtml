@model CourtBooking.ViewModels.CourtAvailabilityViewModel
@{
    ViewData["Title"] = "New Walk-in Booking";
    var courts    = ViewBag.Courts as List<Court>;
    var settings  = ViewBag.Settings as FacilitySettings;
    var rateTiers = ViewBag.CourtRateTiers as List<CourtRateTier> ?? new();
    var rateRanges = ViewBag.RateRanges as Dictionary<int, (decimal Min, decimal Max)>;

    var localNow   = PhtClock.Now;
    var today      = DateOnly.FromDateTime(localNow);
    var selectedDate = Model?.Date ?? (ViewBag.SelectedDate as DateOnly? ?? today);
    bool isPastDate = selectedDate < today;
    bool isToday    = selectedDate == today;
    int  nowHour    = localNow.Hour;
    int  nowMinute  = localNow.Minute;
    bool SlotIsPast(int startHour) => isPastDate || (isToday && (startHour * 60 + 20) < (nowHour * 60 + nowMinute));

    string SportDefaultImage(string sport) => sport?.ToLower() switch {
        "tennis"       => "/images/sports/tennis.svg",
        "badminton"    => "/images/sports/badminton.svg",
        "basketball"   => "/images/sports/basketball.svg",
        "volleyball"   => "/images/sports/volleyball.svg",
        "football"     => "/images/sports/football.svg",
        "futsal"       => "/images/sports/futsal.svg",
        "swimming"     => "/images/sports/swimming.svg",
        "table tennis" => "/images/sports/table-tennis.svg",
        "billiards"    => "/images/sports/billiards.svg",
        "pickleball"   => "/images/sports/pickleball.svg",
        _              => "/images/sports/default.svg"
    };
}

<div class="cb-page-header">
    <div class="container">
        <h1 class="mb-1" style="font-size:1.75rem;">New Walk-in Booking</h1>
        <p style="color:var(--cb-text-2);font-size:.9rem;margin:0;">Pick a court, date, and time for the customer paying cash.</p>
    </div>
</div>

<div class="container py-4">

    @* ── House Rules — same reference customers see on the public facility page ── *@
    @if (!string.IsNullOrWhiteSpace(settings?.HouseRules))
    {
        <div class="mb-4">
            <div class="card" style="border:1px solid var(--cb-border);">
                <button class="card-header d-flex align-items-center justify-content-between w-100 border-0 bg-transparent text-start"
                        type="button" data-bs-toggle="collapse" data-bs-target="#houseRulesBody" aria-expanded="true">
                    <span style="font-size:1rem;font-weight:700;">
                        <i class="bi bi-clipboard-check me-2" style="color:var(--cb-lime);"></i>House Rules
                    </span>
                    <i class="bi bi-chevron-down" style="color:var(--cb-text-3);transform:rotate(180deg);"></i>
                </button>
                <div class="collapse show" id="houseRulesBody">
                    <div class="card-body pt-0" style="white-space:pre-line;color:var(--cb-text-2);font-size:.9rem;line-height:1.7;">@settings.HouseRules</div>
                </div>
            </div>
        </div>
    }

    @* ── Schedule & Pricing — same rate-tier cards customers see per court ── *@
    @if (courts is not null && courts.Any())
    {
        <div class="mb-4">
            <h2 class="mb-3" style="font-size:1.1rem;font-weight:700;letter-spacing:-.01em;">
                <i class="bi bi-clock me-2" style="color:var(--cb-lime);"></i>Schedule &amp; Pricing
            </h2>
            <div class="row g-3">
                @foreach (var c in courts)
                {
                    var tiers = rateTiers.Where(t => t.CourtId == c.Id).OrderBy(t => t.StartHour).ToList();
                    <div class="col-sm-6 col-lg-4">
                        <div class="card h-100" style="border:1px solid var(--cb-border);">
                            <div class="card-body p-3">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <span style="font-weight:700;font-size:.95rem;">@c.Name</span>
                                    <span class="badge ms-auto" style="background:var(--cb-surface-3);color:var(--cb-text-2);font-size:.68rem;">@c.SportType</span>
                                </div>
                                <table class="w-100" style="font-size:.82rem;border-collapse:collapse;">
                                    <thead>
                                        <tr style="color:var(--cb-text-3);font-size:.72rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;border-bottom:1px solid var(--cb-border);">
                                            <th style="padding:.35rem .5rem .35rem 0;font-weight:600;">Hours</th>
                                            <th style="padding:.35rem 0;font-weight:600;">Days</th>
                                            <th style="padding:.35rem 0 .35rem .5rem;font-weight:600;text-align:right;">Rate/hr</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (!tiers.Any())
                                        {
                                            <tr>
                                                <td style="padding:.45rem .5rem .45rem 0;color:var(--cb-text-2);">@TimeDisplay.HourRange(c.OpeningHour, c.ClosingHour)</td>
                                                <td style="padding:.45rem 0;color:var(--cb-text-3);">Every day</td>
                                                <td style="padding:.45rem 0 .45rem .5rem;text-align:right;font-weight:700;color:var(--cb-lime);">₱@c.PricePerHour.ToString("N0")</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var t in tiers.OrderBy(t => t.PricePerHour).ThenBy(t => t.StartHour))
                                            {
                                                var dayLabel = t.IncludeHolidays && string.IsNullOrWhiteSpace(t.DaysOfWeek)
                                                    ? "Holidays"
                                                    : (t.DaysOfWeek.Replace(",", " · ") + (t.IncludeHolidays ? " · Holidays" : ""));
                                                <tr style="border-bottom:1px solid rgba(255,255,255,.05);">
                                                    <td style="padding:.45rem .5rem .45rem 0;color:var(--cb-text-2);">@TimeDisplay.HourRange(t.StartHour, t.EndHour)</td>
                                                    <td style="padding:.45rem 0;color:var(--cb-text-3);font-size:.78rem;">@dayLabel</td>
                                                    <td style="padding:.45rem 0 .45rem .5rem;text-align:right;font-weight:700;color:var(--cb-lime);">₱@t.PricePerHour.ToString("N0")</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                                <div class="mt-2 pt-2" style="border-top:1px solid var(--cb-border);color:var(--cb-text-3);font-size:.78rem;">
                                    <i class="bi bi-clock me-1"></i>Open @TimeDisplay.HourRange(c.OpeningHour, c.ClosingHour)
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ── Courts — pick one to see its availability grid below ── *@
    <div class="row g-4 mb-4">
        @if (courts is null || !courts.Any())
        {
            <div class="col-12">
                <div class="alert alert-warning mb-0">No active courts are set up yet.</div>
            </div>
        }
        else
        {
            @foreach (var c in courts)
            {
                (decimal Min, decimal Max) range = (c.PricePerHour, c.PricePerHour);
                if (rateRanges != null && rateRanges.TryGetValue(c.Id, out var foundRange)) range = foundRange;
                bool hasRange = range.Max > range.Min;
                bool isSelected = Model?.Court.Id == c.Id;

                <div class="col-sm-6 col-lg-4">
                    <a asp-action="NewWalkIn" asp-route-courtId="@c.Id" asp-route-date="@selectedDate.ToString("yyyy-MM-dd")"
                       class="card h-100 text-decoration-none" style="overflow:hidden;@(isSelected ? "border-color:var(--cb-lime);" : "")">
                        <div class="position-relative" style="height:160px;overflow:hidden;">
                            <img src="@(!string.IsNullOrWhiteSpace(c.ImageUrl) ? c.ImageUrl : SportDefaultImage(c.SportType))"
                                 alt="@c.Name" style="width:100%;height:160px;object-fit:cover;" />
                            @if (c.IsIndoor)
                            {
                                <span class="badge position-absolute top-0 end-0 m-2"
                                      style="background:var(--cb-lime-dim);color:var(--cb-lime);border:1px solid rgba(163,255,18,0.3);">Indoor</span>
                            }
                        </div>
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h5 class="mb-0" style="font-weight:700;font-size:1rem;color:var(--cb-text);">@c.Name</h5>
                                <span class="badge" style="background:var(--cb-surface-3);color:var(--cb-text-2);font-size:.68rem;">@c.SportType</span>
                            </div>
                            <div style="color:var(--cb-text-3);font-size:.8rem;">
                                <i class="bi bi-clock me-1" style="color:var(--cb-lime);"></i>@TimeDisplay.HourRange(c.OpeningHour, c.ClosingHour)
                            </div>
                        </div>
                        <div class="card-footer p-3 d-flex justify-content-between align-items-center">
                            <span style="font-weight:700;color:var(--cb-lime);font-size:.9rem;">
                                @if (hasRange)
                                {
                                    @:₱@range.Min.ToString("N0")&ndash;@range.Max.ToString("N0")/hr
                                }
                                else
                                {
                                    @:₱@range.Min.ToString("N0")/hr
                                }
                            </span>
                            <span class="btn btn-sm @(isSelected ? "btn-primary" : "btn-outline-primary")">
                                @(isSelected ? "Selected" : "Select")
                            </span>
                        </div>
                    </a>
                </div>
            }
        }
    </div>

    @if (Model is not null)
    {
        <div class="card">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="mb-0" style="font-size:1rem;font-weight:700;">
                    @Model.Court.Name &mdash; @selectedDate.ToString("dddd, MMMM d, yyyy")
                </h5>
                <form method="get" asp-action="NewWalkIn" class="d-flex gap-2">
                    <input type="hidden" name="courtId" value="@Model.Court.Id" />
                    <input type="date" name="date" class="form-control form-control-sm" style="width:auto;"
                           value="@selectedDate.ToString("yyyy-MM-dd")" min="@today.ToString("yyyy-MM-dd")"
                           onchange="this.form.submit()" />
                </form>
            </div>
            <div class="card-body">
                @if (Model.HasSlots)
                {
                    <div class="row g-3">
                        @foreach (var slot in Model.TimeSlots)
                        {
                            bool isUnavailable = Model.UnavailableSlotIds.Contains(slot.Id);
                            bool isPast        = SlotIsPast(slot.StartHour);
                            decimal price = Model.SlotPrices.TryGetValue(slot.Id, out var _p)
                                ? _p
                                : Model.Court.PricePerHour * slot.DurationHours;

                            <div class="col-sm-6 col-md-4">
                                @if (isPast)
                                {
                                    <div class="h-100 p-3 text-center rounded-3"
                                         style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.5;cursor:default;">
                                        <div class="fw-bold mb-1" style="font-size:.95rem;color:var(--cb-text-3);">@slot.TimeLabel</div>
                                        <div style="font-size:.75rem;color:var(--cb-text-3);">
                                            @slot.DurationHours hr@(slot.DurationHours != 1 ? "s" : "") &middot; ₱@price.ToString("N0")
                                        </div>
                                        <div class="mt-2">
                                            <span class="badge" style="background:var(--cb-surface-3);color:var(--cb-text-3);font-size:.72rem;">
                                                <i class="bi bi-clock-history me-1"></i>Past
                                            </span>
                                        </div>
                                    </div>
                                }
                                else if (isUnavailable)
                                {
                                    <div class="h-100 p-3 text-center rounded-3"
                                         style="opacity:.75;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);">
                                        <div class="fw-bold mb-1" style="font-size:.95rem;color:#f87171;">@slot.TimeLabel</div>
                                        <div style="font-size:.75rem;color:var(--cb-text-3);">
                                            @slot.DurationHours hr@(slot.DurationHours != 1 ? "s" : "") &middot; ₱@price.ToString("N0")
                                        </div>
                                        <div class="mt-2">
                                            <span class="badge" style="background:rgba(239,68,68,0.2);color:#f87171;font-size:.72rem;">
                                                <i class="bi bi-x-circle me-1"></i>Booked
                                            </span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <a asp-action="WalkInForm"
                                       asp-route-courtId="@Model.Court.Id"
                                       asp-route-date="@selectedDate.ToString("yyyy-MM-dd")"
                                       asp-route-startHour="@slot.StartHour"
                                       asp-route-endHour="@slot.EndHour"
                                       class="h-100 p-3 text-center rounded-3 d-block text-decoration-none"
                                       style="background:var(--cb-surface-2);border:1px solid var(--cb-lime);">
                                        <div class="fw-bold mb-1" style="font-size:.95rem;color:var(--cb-text);">@slot.TimeLabel</div>
                                        <div style="font-size:.75rem;color:var(--cb-text-3);">
                                            @slot.DurationHours hr@(slot.DurationHours != 1 ? "s" : "") &middot;
                                            <span style="color:var(--cb-lime);font-weight:600;">₱@price.ToString("N0")</span>
                                        </div>
                                        <div class="mt-2">
                                            <span class="badge" style="background:rgba(34,197,94,0.2);color:#4ade80;font-size:.72rem;">
                                                <i class="bi bi-calendar-plus me-1"></i>Book
                                            </span>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                    </div>

                    @if (Model.TimeSlots.All(s => Model.UnavailableSlotIds.Contains(s.Id)))
                    {
                        <div class="text-center py-4 mt-3" style="border-top:1px solid var(--cb-border);">
                            <i class="bi bi-calendar-x display-6 d-block mb-2" style="color:var(--cb-text-3);"></i>
                            <p style="color:var(--cb-text-3);font-size:.875rem;margin:0;">
                                All slots are booked for this date. Try another day.
                            </p>
                        </div>
                    }
                }
                else
                {
                    <div class="row g-2">
                        @for (int h = Model.Court.OpeningHour; h < Model.Court.ClosingHour; h++)
                        {
                            bool isBooked  = Model.BookedHours.Contains(h);
                            bool isPending = Model.PendingHours.Contains(h);
                            bool isBlocked = Model.BlockedHours.Contains(h);
                            bool isPast    = SlotIsPast(h);
                            bool isOpenPlay = Model.OpenPlayHours.Contains(h);
                            bool isBundleOnly = Model.BundleOnlyHours.TryGetValue(h, out var bundleMatch);
                                bool isPendingBundle = Model.PendingBundleWindows.TryGetValue(h, out var pendingBundle);
                            var rate = Model.HourlyRates.TryGetValue(h, out var r) ? r : Model.Court.PricePerHour;
                            var timeLabel = TimeDisplay.HourRange(h, h + 1);

                                if (!isPast && !isBooked && !isBlocked && isPendingBundle)
                                {
                                    var bundleEndHour = pendingBundle.EndTime == TimeOnly.MinValue ? 24 : pendingBundle.EndTime.Hour;
                                    var pendingLabel = TimeDisplay.HourRange(pendingBundle.StartTime.Hour, bundleEndHour);
                                    <div class="col-12">
                                        <div class="p-2 text-center rounded-3" style="background:rgba(234,179,8,0.12);border:1px solid rgba(234,179,8,0.4);opacity:.85;cursor:default;">
                                            <div style="font-size:.85rem;color:#eab308;font-weight:700;">@pendingLabel</div>
                                            <div style="font-size:.7rem;color:#ca8a04;margin-top:2px;"><i class="bi bi-box-seam me-1"></i>Bundle Pending</div>
                                            @if (pendingBundle.CourtBundle is not null)
                                            {
                                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@pendingBundle.CourtBundle.Name</div>
                                            }
                                        </div>
                                    </div>
                                    h = bundleEndHour - 1;
                                    continue;
                                }
                            if (!isPast && !isBooked && !isPending && !isBlocked && isBundleOnly)
                            {
                                var bundleLabel = TimeDisplay.HourRange(bundleMatch.Block.StartHour, bundleMatch.Block.EndHour);
                                <div class="col-12">
                                    <a asp-action="WalkInBundleForm"
                                       asp-route-bundleId="@bundleMatch.Bundle.Id"
                                                    asp-route-courtId="@Model.Court.Id"
                                       asp-route-date="@selectedDate.ToString("yyyy-MM-dd")"
                                       asp-route-startHour="@bundleMatch.Block.StartHour"
                                       asp-route-endHour="@bundleMatch.Block.EndHour"
                                       class="p-2 text-center rounded-3 d-block text-decoration-none"
                                       style="background:var(--cb-surface-2);border:1px solid var(--cb-lime);">
                                        <div style="font-size:.85rem;color:var(--cb-text);font-weight:700;">@bundleLabel</div>
                                        <div style="font-size:.7rem;color:var(--cb-lime);margin-top:2px;font-weight:600;">
                                            <i class="bi bi-box-seam me-1"></i>Bundle Only
                                        </div>
                                    </a>
                                </div>
                                h = bundleMatch.Block.EndHour - 1;
                                continue;
                            }

                            bool isOpenPlaySignup = Model.OpenPlaySignupInfo.TryGetValue(h, out var signupMatch);
                            if (!isPast && !isBooked && !isPending && !isBlocked && isOpenPlaySignup)
                            {
                                var openPlayLabel = TimeDisplay.HourRange(signupMatch.Block.StartHour, signupMatch.Block.EndHour);
                                bool isUnlimited = signupMatch.SpotsRemaining == int.MaxValue;
                                <div class="col-12">
                                    @if (isUnlimited || signupMatch.SpotsRemaining > 0)
                                    {
                                        <a asp-action="OpenPlayForm"
                                           asp-route-courtId="@Model.Court.Id"
                                           asp-route-date="@selectedDate.ToString("yyyy-MM-dd")"
                                           asp-route-startHour="@signupMatch.Block.StartHour"
                                           asp-route-endHour="@signupMatch.Block.EndHour"
                                           class="p-2 text-center rounded-3 d-block text-decoration-none"
                                           style="background:var(--cb-surface-2);border:1px solid var(--cb-lime);">
                                            <div style="font-size:.85rem;color:var(--cb-text);font-weight:700;">@openPlayLabel</div>
                                            <div style="font-size:.7rem;color:var(--cb-lime);margin-top:2px;font-weight:600;">
                                                <i class="bi bi-people me-1"></i>Open Play
                                                @if (signupMatch.Block.PricePerHead.HasValue)
                                                {
                                                    <text>&middot; ₱@signupMatch.Block.PricePerHead.Value.ToString("N0")/head</text>
                                                }
                                                @if (!isUnlimited)
                                                {
                                                    <text>&middot; @signupMatch.SpotsRemaining spot@(signupMatch.SpotsRemaining != 1 ? "s" : "") left</text>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(signupMatch.Block.Description))
                                            {
                                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@signupMatch.Block.Description</div>
                                            }
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="p-2 text-center rounded-3" style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.75;">
                                            <div style="font-size:.85rem;color:var(--cb-text-2);font-weight:700;">@openPlayLabel</div>
                                            <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">
                                                Open Play — Full
                                                @if (signupMatch.Block.PricePerHead.HasValue)
                                                {
                                                    <text>&middot; ₱@signupMatch.Block.PricePerHead.Value.ToString("N0")/head</text>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(signupMatch.Block.Description))
                                            {
                                                <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@signupMatch.Block.Description</div>
                                            }
                                        </div>
                                    }
                                </div>
                                h = signupMatch.Block.EndHour - 1;
                                continue;
                            }

                            <div class="col-6 col-sm-4 col-md-3">
                                @if (isPast)
                                {
                                    <div class="p-2 text-center rounded-3" style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.45;">
                                        <div style="font-size:.8rem;color:var(--cb-text-3);font-weight:600;">@timeLabel</div>
                                        <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">Past</div>
                                    </div>
                                }
                                else if (isBooked)
                                {
                                    <div class="p-2 text-center rounded-3" style="opacity:.7;background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.2);">
                                        <div style="font-size:.8rem;color:#f87171;font-weight:600;">@timeLabel</div>
                                        <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">Booked@(isOpenPlay ? " • Open Play" : "")</div>
                                    </div>
                                }
                                else if (isPending)
                                {
                                    <div class="p-2 text-center rounded-3" style="background:rgba(234,179,8,0.12);border:1px solid rgba(234,179,8,0.4);opacity:.85;">
                                        <div style="font-size:.8rem;color:#eab308;font-weight:600;">@timeLabel</div>
                                        <div style="font-size:.7rem;color:#ca8a04;margin-top:2px;"><i class="bi bi-hourglass-split me-1"></i>Pending</div>
                                    </div>
                                }
                                else if (isBlocked)
                                {
                                    var blockReason = Model.BlockReasons.TryGetValue(h, out var _br) ? _br : null;
                                    <div class="p-2 text-center rounded-3" style="background:var(--cb-surface-2);border:1px solid var(--cb-border);opacity:.55;">
                                        <div style="font-size:.8rem;color:var(--cb-text-3);font-weight:600;">@timeLabel</div>
                                        <div style="font-size:.7rem;color:var(--cb-text-3);margin-top:2px;">@(blockReason ?? "Unavailable")</div>
                                    </div>
                                }
                                else
                                {
                                    <a asp-action="WalkInForm"
                                       asp-route-courtId="@Model.Court.Id"
                                       asp-route-date="@selectedDate.ToString("yyyy-MM-dd")"
                                       asp-route-startHour="@h"
                                       class="p-2 text-center rounded-3 d-block text-decoration-none"
                                       style="background:var(--cb-surface-2);border:1px solid var(--cb-lime);">
                                        <div style="font-size:.8rem;color:var(--cb-text);font-weight:600;">@timeLabel</div>
                                        <div style="font-size:.7rem;color:var(--cb-lime);margin-top:2px;font-weight:600;">₱@rate.ToString("N0")</div>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>
