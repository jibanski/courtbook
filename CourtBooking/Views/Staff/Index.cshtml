@using CourtBooking.ViewModels
@model object
@{
    ViewData["Title"] = "Front Desk";
    var courts = ViewBag.Courts as List<CourtBooking.Models.Court>;
    var todaysBookings = ViewBag.TodaysBookings as List<AdminBookingRow>;
}

<div class="cb-page-header">
    <div class="container">
        <h1 class="mb-1" style="font-size:1.75rem;">Front Desk</h1>
        <p style="color:var(--cb-text-2);font-size:.9rem;margin:0;">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</p>
    </div>
</div>

<div class="container py-4">
    <div class="mb-4">
        <p class="cb-stat-label mb-2">QUICK ACTIONS</p>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="NewWalkIn" class="cb-quick-action"><i class="bi bi-calendar-plus"></i>New Walk-in Booking</a>
            <a asp-action="MyCashLog" class="cb-quick-action"><i class="bi bi-cash-coin"></i>My Cash Log</a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0" style="font-size:1rem;font-weight:700;">
                <i class="bi bi-calendar-day me-2" style="color:var(--cb-lime);"></i>Today's Bookings
            </h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Court</th>
                        <th>Time</th>
                        <th>Amount</th>
                        <th>Payment</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (todaysBookings is null || !todaysBookings.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4" style="color:var(--cb-text-3);">No bookings today.</td></tr>
                    }
                    else
                    {
                        @foreach (var b in todaysBookings)
                        {
                            <tr>
                                <td>
                                    @b.CustomerName
                                    @if (b.PlayerNames is not null)
                                    {
                                        <div class="small text-muted">with @b.PlayerNames</div>
                                    }
                                </td>
                                <td>
                                    @b.CourtName
                                    @if (b.IsOpenPlay)
                                    {
                                        <span class="badge bg-primary-subtle text-primary-emphasis ms-1" style="font-size:.65rem;">
                                            <i class="bi bi-people"></i> Open Play &middot; @b.SpotCount spot@(b.SpotCount != 1 ? "s" : "")
                                        </span>
                                    }
                                </td>
                                <td>@TimeDisplay.HourRange(b.StartTime.Hour, b.EndTime.Hour)</td>
                                <td>₱@b.TotalPrice.ToString("N0")</td>
                                <td>@(b.PaymentMethod ?? "—")</td>
                                <td>@b.Status</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (courts is null || !courts.Any())
    {
        <div class="alert alert-warning mt-4">No active courts are set up yet — ask the owner to add one.</div>
    }
</div>
