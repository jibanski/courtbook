@{
    ViewData["Title"] = "Confirm Open Play Sign-up";
    var court = ViewBag.Court as CourtBooking.Models.Court;
    var block = ViewBag.Block as CourtBooking.Models.CourtScheduleBlock;
    DateOnly date = ViewBag.Date;
    int? spotsRemaining = ViewBag.SpotsRemaining as int?;
    var paymentMethods = ViewBag.PaymentMethods as List<string> ?? new List<string> { "Cash" };
    var pricePerHead = block?.PricePerHead ?? 0;
    const int unlimitedDropdownMax = 20;
    int spotOptionsMax = spotsRemaining ?? unlimitedDropdownMax;
}

<div class="cb-page-header">
    <div class="container">
        <h1 class="mb-1" style="font-size:1.75rem;">Confirm Open Play Sign-up</h1>
    </div>
</div>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0 fw-bold">@court?.Name &mdash; @court?.SportType</h5>
                    <small class="text-muted">
                        @date.ToString("dddd, MMMM d, yyyy") &bull; @TimeDisplay.HourRange(block?.StartHour ?? 0, block?.EndHour ?? 0)
                        @if (spotsRemaining.HasValue)
                        {
                            <text>&bull; @spotsRemaining spot@(spotsRemaining != 1 ? "s" : "") left</text>
                        }
                        else
                        {
                            <text>&bull; no spot limit set</text>
                        }
                    </small>
                </div>
                <div class="card-body">
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    @if (!block!.PricePerHead.HasValue || block.PricePerHead.Value == 0)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            No price is set for this Open Play session yet, so Amount Due will show ₱0.
                            Ask the facility owner to set a ₱/Head price via <strong>Manage &gt; [Court] &gt; Default Schedule &amp; Rates</strong>.
                        </div>
                    }
                    <form asp-action="CreateOpenPlaySignup" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courtId" value="@court?.Id" />
                        <input type="hidden" name="date" value="@date.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="startHour" value="@block?.StartHour" />
                        <input type="hidden" name="endHour" value="@block?.EndHour" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Customer Name</label>
                            <input name="customerName" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Customer Phone</label>
                            <input type="tel" name="customerPhone" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Number of Spots</label>
                            <select name="spotCount" class="form-select" id="spotCountSelect">
                                @for (int s = 1; s <= spotOptionsMax; s++)
                                {
                                    <option value="@s">@s spot@(s != 1 ? "s" : "")</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3" id="playerNamesField" style="display:none;">
                            <label class="form-label fw-semibold">Other Player Names <span class="text-muted fw-normal">(optional)</span></label>
                            <input name="playerNames" class="form-control" placeholder="e.g. Juan, Maria, Pedro" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Payment Method</label>
                            <select name="paymentMethod" class="form-select" id="paymentMethodSelect">
                                @foreach (var method in paymentMethods)
                                {
                                    <option value="@method">@method</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3" id="referenceField" style="display:none;">
                            <label class="form-label fw-semibold">Reference Number <span class="text-muted fw-normal">(optional)</span></label>
                            <input name="paymentReference" class="form-control" placeholder="e.g. GCash/Maya reference number" />
                        </div>
                        <div class="mb-3" id="proofField" style="display:none;">
                            <label class="form-label fw-semibold">Proof of Payment <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="file" name="paymentProof" class="form-control" accept="image/jpeg,image/png,image/webp" />
                            <div class="form-text">Screenshot of the GCash/Maya payment confirmation, for your records.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Notes <span class="text-muted fw-normal">(optional)</span></label>
                            <textarea name="notes" class="form-control" rows="2"></textarea>
                        </div>

                        <div class="alert alert-primary">
                            <div class="d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-cash-coin me-2"></i><strong>Amount Due</strong></span>
                                <span class="fs-5 fw-bold" id="totalPrice">₱@pricePerHead.ToString("N0")</span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
                            <a asp-action="NewWalkIn" asp-route-courtId="@court?.Id" asp-route-date="@date.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i>Confirm Payment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const pricePerHead = @pricePerHead;
    const spotCountSelect = document.getElementById('spotCountSelect');
    const playerNamesField = document.getElementById('playerNamesField');

    function updateTotal() {
        const spots = parseInt(spotCountSelect?.value || 1);
        document.getElementById('totalPrice').textContent = '₱' + (pricePerHead * spots).toLocaleString();
        playerNamesField.style.display = spots > 1 ? '' : 'none';
    }
    spotCountSelect?.addEventListener('change', updateTotal);
    updateTotal();

    const paymentMethodSelect = document.getElementById('paymentMethodSelect');
    const referenceField = document.getElementById('referenceField');
    const proofField = document.getElementById('proofField');
    function toggleReferenceField() {
        const show = paymentMethodSelect.value !== 'Cash';
        referenceField.style.display = show ? '' : 'none';
        proofField.style.display = show ? '' : 'none';
    }
    paymentMethodSelect?.addEventListener('change', toggleReferenceField);
    toggleReferenceField();
</script>
}
