@using CourtBooking.Models
@{
    ViewData["Title"] = "Bundle Peak Windows";
    var bundle = ViewBag.Bundle as CourtBundle;
    var blocks = ViewBag.RateBlocks as List<CourtBundleRateBlock> ?? new();
    var days   = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
}

<div class="cb-page-header">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb mb-0" style="font-size:.8rem;">
                <li class="breadcrumb-item">
                    <a asp-action="Bundles" style="color:var(--cb-text-3);text-decoration:none;">Bundles</a>
                </li>
                <li class="breadcrumb-item active" style="color:var(--cb-text-2);">@bundle!.Name</li>
            </ol>
        </nav>
        <h1 class="mb-0" style="font-size:1.5rem;font-weight:800;">@bundle.Name — Peak Windows</h1>
        <p class="mb-0" style="color:var(--cb-text-3);font-size:.875rem;">
            Courts: @string.Join(", ", bundle.Courts.Select(c => c.Court.Name)) &bull;
            Add recurring windows when this bundle is sellable as a flat-price package instead of individual court booking.
        </p>
    </div>
</div>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-11">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="card mb-4">
                <div class="card-body p-4">
                    @if (blocks.Any())
                    {
                        <div class="table-responsive mb-4">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr><th>Days</th><th>Hours</th><th>Flat Price</th><th>Status</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in blocks)
                                    {
                                        <tr class="@(b.IsActive ? "" : "opacity-50")">
                                            <td>
                                                @b.DaysOfWeek
                                                @if (b.IncludeHolidays)
                                                {
                                                    <span class="badge bg-secondary ms-1">+ Holidays</span>
                                                }
                                            </td>
                                            <td>
                                                @TimeDisplay.HourRange(b.StartHour, b.EndHour)
                                                @if (bundle.Courts.Any(c => b.StartHour < c.Court.OpeningHour || b.EndHour > c.Court.ClosingHour))
                                                {
                                                    <br /><span class="badge bg-warning text-dark mt-1">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>Outside a member court's hours
                                                    </span>
                                                }
                                            </td>
                                            <td>₱@b.FlatPrice.ToString("N0")</td>
                                            <td>
                                                @if (b.IsActive)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary-emphasis">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Paused</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <form asp-action="ToggleBundleRateBlock" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@b.Id" />
                                                    <input type="hidden" name="bundleId" value="@bundle.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(b.IsActive ? "Pause" : "Enable")">
                                                        <i class="bi bi-@(b.IsActive ? "pause-fill" : "play-fill")"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="DeleteBundleRateBlock" method="post" onsubmit="return confirm('Remove this window?')" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@b.Id" />
                                                    <input type="hidden" name="bundleId" value="@bundle.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="mb-4" style="color:var(--cb-text-3);font-size:.825rem;">
                            <i class="bi bi-info-circle me-1" style="color:var(--cb-lime);"></i>
                            No peak windows yet — this bundle isn't sellable until you add one.
                        </p>
                    }

                    <form asp-action="AddBundleRateBlock" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="bundleId" value="@bundle.Id" />
                        <div class="col-12">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">Days</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var d in days)
                                {
                                    <label class="form-check form-check-inline">
                                        <input type="checkbox" class="form-check-input" name="days" value="@d" />
                                        <span class="form-check-label small">@d</span>
                                    </label>
                                }
                                <label class="form-check form-check-inline ms-2">
                                    <input type="checkbox" class="form-check-input" name="includeHolidays" value="true" />
                                    <span class="form-check-label small">+ Holidays</span>
                                </label>
                            </div>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">Start</label>
                            <select name="startHour" class="form-select form-select-sm">
                                @for (int h = 0; h < 24; h++)
                                {
                                    <option value="@h">@TimeDisplay.Hour(h)</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">End</label>
                            <select name="endHour" class="form-select form-select-sm">
                                @for (int h = 1; h <= 24; h++)
                                {
                                    <option value="@h">@TimeDisplay.Hour(h)</option>
                                }
                            </select>
                        </div>
                        <div class="col-3">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">Flat Price (all courts)</label>
                            <input type="number" name="flatPrice" step="0.01" min="0" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-1">
                            <button type="submit" class="btn btn-primary btn-sm w-100" title="Add window">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <a asp-action="Bundles" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Bundles
            </a>

        </div>
    </div>
</div>
