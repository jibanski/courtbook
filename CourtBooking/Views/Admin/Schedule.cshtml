@using CourtBooking.Models
@{
    ViewData["Title"] = "Default Schedule & Rates";
    var court  = ViewBag.Court as Court;
    var tiers  = ViewBag.RateTiers as List<CourtRateTier> ?? new();
    var blocks = ViewBag.ScheduleBlocks as List<CourtScheduleBlock> ?? new();
    var days   = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
}

<div class="cb-page-header">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb mb-0" style="font-size:.8rem;">
                <li class="breadcrumb-item">
                    <a asp-action="Courts" style="color:var(--cb-text-3);text-decoration:none;">Courts</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-action="EditCourt" asp-route-id="@court!.Id" style="color:var(--cb-text-3);text-decoration:none;">@court.Name</a>
                </li>
                <li class="breadcrumb-item active" style="color:var(--cb-text-2);">Default Schedule &amp; Rates</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-3">
            <span class="d-inline-flex align-items-center justify-content-center rounded-3"
                  style="width:48px;height:48px;background:var(--cb-lime-dim);border:1px solid rgba(163,255,18,0.25);flex-shrink:0;">
                <i class="bi bi-calendar-week fs-4" style="color:var(--cb-lime);"></i>
            </span>
            <div>
                <h1 class="mb-0" style="font-size:1.5rem;font-weight:800;">@court.Name — Default Schedule &amp; Rates</h1>
                <p class="mb-0" style="color:var(--cb-text-3);font-size:.875rem;">
                    Set your recurring weekly default — day-of-week rate tiers and hours reserved for Admin-Hosted Open Play.
                    Date-specific blocks and custom windows (in Availability) always override these defaults.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-11">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @* ── Rate Tiers ── *@
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0 fw-bold" style="font-size:.875rem;">
                        <i class="bi bi-tag me-2" style="color:var(--cb-lime);"></i>Rate Tiers
                    </h6>
                    <p class="mb-0 mt-1" style="font-size:.78rem;color:var(--cb-text-3);">
                        Base rate is ₱@court.PricePerHour.ToString("N0")/hr. Add a tier to charge a different rate on specific
                        days and hours (e.g. weekday off-peak vs. weekend/holiday rate).
                    </p>
                </div>
                <div class="card-body p-4">
                    @if (tiers.Any())
                    {
                        <div class="table-responsive mb-4">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr><th>Days</th><th>Hours</th><th>Rate</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in tiers)
                                    {
                                        <tr>
                                            <td>
                                                @t.DaysOfWeek
                                                @if (t.IncludeHolidays)
                                                {
                                                    <span class="badge bg-secondary ms-1">+ Holidays</span>
                                                }
                                            </td>
                                            <td>
                                                @TimeDisplay.HourRange(t.StartHour, t.EndHour)
                                                @if (t.StartHour < court.OpeningHour || t.EndHour > court.ClosingHour)
                                                {
                                                    <br /><span class="badge bg-warning text-dark mt-1" title="Outside this court's operating hours (@TimeDisplay.HourRange(court.OpeningHour, court.ClosingHour)) — won't appear on the availability grid.">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>Outside operating hours
                                                    </span>
                                                }
                                            </td>
                                            <td>₱@t.PricePerHour.ToString("N0")/hr</td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-sm btn-outline-info me-1" title="Edit this rate tier"
                                                        data-bs-toggle="modal" data-bs-target="#editTierModal-@t.Id">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form asp-action="DeleteRateTier" method="post" onsubmit="return confirm('Remove this rate tier?')" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@t.Id" />
                                                    <input type="hidden" name="courtId" value="@court.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @foreach (var t in tiers)
                        {
                            var tierDays = t.DaysOfWeek.Split(',', StringSplitOptions.RemoveEmptyEntries);
                            <div class="modal fade" id="editTierModal-@t.Id" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form asp-action="EditRateTier" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@t.Id" />
                                            <input type="hidden" name="courtId" value="@court.Id" />
                                            <div class="modal-header">
                                                <h6 class="modal-title">Edit Rate Tier &mdash; @TimeDisplay.HourRange(t.StartHour, t.EndHour)</h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Days</label>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach (var d in days)
                                                        {
                                                            <label class="form-check form-check-inline">
                                                                <input type="checkbox" class="form-check-input" name="days" value="@d"
                                                                       @(tierDays.Contains(d, StringComparer.OrdinalIgnoreCase) ? "checked" : "") />
                                                                <span class="form-check-label small">@d</span>
                                                            </label>
                                                        }
                                                        <label class="form-check form-check-inline ms-2">
                                                            <input type="checkbox" class="form-check-input" name="includeHolidays" value="true"
                                                                   @(t.IncludeHolidays ? "checked" : "") />
                                                            <span class="form-check-label small">+ Holidays</span>
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="row g-2">
                                                    <div class="col-4">
                                                        <label class="form-label small fw-semibold">Start</label>
                                                        <select name="startHour" class="form-select form-select-sm">
                                                            @for (int h = 0; h < 24; h++)
                                                            {
                                                                if (t.StartHour == h)
                                                                {
                                                                    <option value="@h" selected>@TimeDisplay.Hour(h)</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@h">@TimeDisplay.Hour(h)</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-4">
                                                        <label class="form-label small fw-semibold">End</label>
                                                        <select name="endHour" class="form-select form-select-sm">
                                                            @for (int h = 1; h <= 24; h++)
                                                            {
                                                                if (t.EndHour == h)
                                                                {
                                                                    <option value="@h" selected>@TimeDisplay.Hour(h)</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@h">@TimeDisplay.Hour(h)</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-4">
                                                        <label class="form-label small fw-semibold">₱/hr</label>
                                                        <input type="number" name="pricePerHour" step="0.01" min="0"
                                                               class="form-control form-control-sm" value="@t.PricePerHour" required />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="mb-4" style="color:var(--cb-text-3);font-size:.825rem;">
                            <i class="bi bi-info-circle me-1" style="color:var(--cb-lime);"></i>
                            No rate tiers yet — every hour uses the base rate of ₱@court.PricePerHour.ToString("N0")/hr.
                        </p>
                    }

                    <form asp-action="AddRateTier" method="post" class="row g-2 align-items-end">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courtId" value="@court.Id" />
                        <div class="col-12">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">Days</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var d in days)
                                {
                                    <label class="form-check form-check-inline">
                                        <input type="checkbox" class="form-check-input" name="days" value="@d" />
                                        <span class="form-check-label small">@d</span>
                                    </label>
                                }
                                <label class="form-check form-check-inline ms-2">
                                    <input type="checkbox" class="form-check-input" name="includeHolidays" value="true" />
                                    <span class="form-check-label small">+ Holidays</span>
                                </label>
                            </div>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">Start</label>
                            <select name="startHour" class="form-select form-select-sm">
                                @for (int h = 0; h < 24; h++)
                                {
                                    <option value="@h">@TimeDisplay.Hour(h)</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">End</label>
                            <select name="endHour" class="form-select form-select-sm">
                                @for (int h = 1; h <= 24; h++)
                                {
                                    <option value="@h">@TimeDisplay.Hour(h)</option>
                                }
                            </select>
                        </div>
                        <div class="col-3">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">₱/hr</label>
                            <input type="number" name="pricePerHour" step="0.01" min="0" class="form-control form-control-sm" required />
                        </div>
                        <div class="col-1">
                            <button type="submit" class="btn btn-primary btn-sm w-100" title="Add rate tier">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            @* ── Schedule Blocks ── *@
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0 fw-bold" style="font-size:.875rem;">
                        <i class="bi bi-people me-2" style="color:var(--cb-lime);"></i>Recurring Booking Type
                    </h6>
                    <p class="mb-0 mt-1" style="font-size:.78rem;color:var(--cb-text-3);">
                        By default every hour is Hourly Rental. Add a block to reserve recurring days/hours for
                        Admin-Hosted Open Play instead — customers won't see those hours as directly bookable.
                        Optionally enable public sign-up so customers can reserve a spot directly.
                    </p>
                </div>
                <div class="card-body p-4">
                    @if (blocks.Any())
                    {
                        <div class="table-responsive mb-4">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr><th>Days</th><th>Hours</th><th>Type</th><th>Price/Head</th><th>Sign-up</th><th>Status</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in blocks)
                                    {
                                        <tr class="@(b.IsActive ? "" : "opacity-50")">
                                            <td>
                                                @b.DaysOfWeek
                                                @if (b.IncludeHolidays)
                                                {
                                                    <span class="badge bg-secondary ms-1">+ Holidays</span>
                                                }
                                            </td>
                                            <td>
                                                @TimeDisplay.HourRange(b.StartHour, b.EndHour)
                                                @if (b.StartHour < court.OpeningHour || b.EndHour > court.ClosingHour)
                                                {
                                                    <br /><span class="badge bg-warning text-dark mt-1" title="Outside this court's operating hours (@TimeDisplay.HourRange(court.OpeningHour, court.ClosingHour)) — won't appear on the availability grid.">
                                                        <i class="bi bi-exclamation-triangle me-1"></i>Outside operating hours
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (b.Type == BookingType.AdminHostedOpenPlay)
                                                {
                                                    <span class="badge bg-secondary">Admin-Hosted Open Play</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Hourly Rental</span>
                                                }
                                            </td>
                                            <td>
                                                @if (b.Type == BookingType.AdminHostedOpenPlay)
                                                {
                                                    @if (b.PricePerHead.HasValue)
                                                    {
                                                        <text>₱@b.PricePerHead.Value.ToString("N0")/head</text>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">—</span>
                                                    }
                                                    @if (b.MaxPlayers.HasValue)
                                                    {
                                                        <div class="small text-muted">Max @b.MaxPlayers</div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(b.Description))
                                                    {
                                                        <div class="small text-muted">@b.Description</div>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (b.Type == BookingType.AdminHostedOpenPlay)
                                                {
                                                    @if (b.AllowPublicSignup)
                                                    {
                                                        <span class="badge" style="background:var(--cb-lime);color:#000;">Public</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Staff only</span>
                                                    }
                                                }
                                            </td>
                                            <td>
                                                @if (b.IsActive)
                                                {
                                                    <span class="badge bg-primary-subtle text-primary-emphasis">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Paused</span>
                                                }
                                            </td>
                                            <td class="text-end text-nowrap">
                                                <button type="button" class="btn btn-sm btn-outline-info me-1" title="Edit this block"
                                                        data-bs-toggle="modal" data-bs-target="#editBlockModal-@b.Id">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form asp-action="ToggleScheduleBlock" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@b.Id" />
                                                    <input type="hidden" name="courtId" value="@court.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(b.IsActive ? "Pause this block" : "Enable this block")">
                                                        <i class="bi bi-@(b.IsActive ? "pause-fill" : "play-fill")"></i>
                                                    </button>
                                                </form>
                                                <form asp-action="DeleteScheduleBlock" method="post" onsubmit="return confirm('Remove this schedule block?')" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@b.Id" />
                                                    <input type="hidden" name="courtId" value="@court.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @foreach (var b in blocks)
                        {
                            var blockDays = b.DaysOfWeek.Split(',', StringSplitOptions.RemoveEmptyEntries);
                            <div class="modal fade" id="editBlockModal-@b.Id" tabindex="-1">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content">
                                        <form asp-action="EditScheduleBlock" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@b.Id" />
                                            <input type="hidden" name="courtId" value="@court.Id" />
                                            <div class="modal-header">
                                                <h6 class="modal-title">Edit Schedule Block &mdash; @TimeDisplay.HourRange(b.StartHour, b.EndHour)</h6>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Days</label>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach (var d in days)
                                                        {
                                                            <label class="form-check form-check-inline">
                                                                <input type="checkbox" class="form-check-input" name="days" value="@d"
                                                                       @(blockDays.Contains(d, StringComparer.OrdinalIgnoreCase) ? "checked" : "") />
                                                                <span class="form-check-label small">@d</span>
                                                            </label>
                                                        }
                                                        <label class="form-check form-check-inline ms-2">
                                                            <input type="checkbox" class="form-check-input" name="includeHolidays" value="true"
                                                                   @(b.IncludeHolidays ? "checked" : "") />
                                                            <span class="form-check-label small">+ Holidays</span>
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-4">
                                                        <label class="form-label small fw-semibold">Start</label>
                                                        <select name="startHour" class="form-select form-select-sm">
                                                            @for (int h = 0; h < 24; h++)
                                                            {
                                                                if (b.StartHour == h)
                                                                {
                                                                    <option value="@h" selected>@TimeDisplay.Hour(h)</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@h">@TimeDisplay.Hour(h)</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-4">
                                                        <label class="form-label small fw-semibold">End</label>
                                                        <select name="endHour" class="form-select form-select-sm">
                                                            @for (int h = 1; h <= 24; h++)
                                                            {
                                                                if (b.EndHour == h)
                                                                {
                                                                    <option value="@h" selected>@TimeDisplay.Hour(h)</option>
                                                                }
                                                                else
                                                                {
                                                                    <option value="@h">@TimeDisplay.Hour(h)</option>
                                                                }
                                                            }
                                                        </select>
                                                    </div>
                                                    <div class="col-4">
                                                        <label class="form-label small fw-semibold">Type</label>
                                                        <select name="type" class="form-select form-select-sm edit-block-type-select">
                                                            @if (b.Type == BookingType.AdminHostedOpenPlay)
                                                            {
                                                                <option value="@BookingType.AdminHostedOpenPlay" selected>Admin-Hosted Open Play</option>
                                                                <option value="@BookingType.HourlyRental">Hourly Rental</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@BookingType.AdminHostedOpenPlay">Admin-Hosted Open Play</option>
                                                                <option value="@BookingType.HourlyRental" selected>Hourly Rental</option>
                                                            }
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="open-play-fields @(b.Type == BookingType.AdminHostedOpenPlay ? "" : "d-none")" style="border:1px solid var(--bs-border-color);border-radius:.375rem;padding:1rem;">
                                                    <div class="row g-2">
                                                        <div class="col-6">
                                                            <label class="form-label small fw-semibold">₱/Head</label>
                                                            <input type="number" name="pricePerHead" step="0.01" min="0" class="form-control form-control-sm" value="@b.PricePerHead" />
                                                        </div>
                                                        <div class="col-6">
                                                            <label class="form-label small fw-semibold">Max Players <span class="text-muted fw-normal">(blank = unlimited)</span></label>
                                                            <input type="number" name="maxPlayers" min="1" class="form-control form-control-sm" value="@b.MaxPlayers" />
                                                        </div>
                                                    </div>
                                                    <div class="mt-3">
                                                        <label class="form-label small fw-semibold">Description <span class="text-muted fw-normal">(optional)</span></label>
                                                        <textarea name="description" class="form-control form-control-sm" rows="2" placeholder="e.g. Warm-up + rotation game">@b.Description</textarea>
                                                    </div>
                                                    <label class="form-check mt-3 mb-0">
                                                        <input type="checkbox" class="form-check-input" name="allowPublicSignup" value="true"
                                                               @(b.AllowPublicSignup ? "checked" : "") />
                                                        <span class="form-check-label small">Enable public sign-up — customers can reserve a spot directly</span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary btn-sm">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="mb-4" style="color:var(--cb-text-3);font-size:.825rem;">
                            <i class="bi bi-info-circle me-1" style="color:var(--cb-lime);"></i>
                            No schedule blocks yet — every hour defaults to Hourly Rental.
                        </p>
                    }

                    <form asp-action="AddScheduleBlock" method="post" class="row g-2 align-items-end" id="addScheduleBlockForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courtId" value="@court.Id" />
                        <div class="col-12">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">Days</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var d in days)
                                {
                                    <label class="form-check form-check-inline">
                                        <input type="checkbox" class="form-check-input" name="days" value="@d" />
                                        <span class="form-check-label small">@d</span>
                                    </label>
                                }
                                <label class="form-check form-check-inline ms-2">
                                    <input type="checkbox" class="form-check-input" name="includeHolidays" value="true" />
                                    <span class="form-check-label small">+ Holidays</span>
                                </label>
                            </div>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">Start</label>
                            <select name="startHour" class="form-select form-select-sm">
                                @for (int h = 0; h < 24; h++)
                                {
                                    <option value="@h">@TimeDisplay.Hour(h)</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">End</label>
                            <select name="endHour" class="form-select form-select-sm">
                                @for (int h = 1; h <= 24; h++)
                                {
                                    <option value="@h">@TimeDisplay.Hour(h)</option>
                                }
                            </select>
                        </div>
                        <div class="col-3">
                            <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">Type</label>
                            <select name="type" id="scheduleBlockType" class="form-select form-select-sm">
                                <option value="@BookingType.AdminHostedOpenPlay">Admin-Hosted Open Play</option>
                                <option value="@BookingType.HourlyRental">Hourly Rental</option>
                            </select>
                        </div>
                        <div class="col-1">
                            <button type="submit" class="btn btn-primary btn-sm w-100" title="Add schedule block">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                        <div class="col-12" id="publicSignupFields">
                            <div class="border rounded-3 p-3 mt-2" style="background:var(--cb-surface-2);">
                                <p class="small text-muted mb-2">
                                    Price/Head and Max Players apply whenever front-desk staff register a walk-in into
                                    this Open Play session — set them here even if you don't want customers to self-sign-up online.
                                </p>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">Max Players <span class="text-muted fw-normal">(blank = unlimited)</span></label>
                                        <input type="number" name="maxPlayers" min="1" class="form-control form-control-sm" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">₱/Head</label>
                                        <input type="number" name="pricePerHead" step="0.01" min="0" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                    <div class="mt-3">
                                        <label class="form-label small fw-semibold mb-1" style="color:var(--cb-text-2);">Description <span class="text-muted fw-normal">(optional)</span></label>
                                        <textarea name="description" class="form-control form-control-sm" rows="2" placeholder="e.g. Open play roster / rotation note"></textarea>
                                    </div>
                                <label class="form-check mt-3 mb-0">
                                    <input type="checkbox" class="form-check-input" name="allowPublicSignup" value="true" id="allowPublicSignupCheck" />
                                    <span class="form-check-label small fw-semibold">Enable public sign-up — customers can reserve a spot directly</span>
                                </label>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <p class="mb-4">
                <a asp-action="OpenPlaySignups" style="color:var(--cb-text-2);font-size:.85rem;">
                    <i class="bi bi-people me-1" style="color:var(--cb-lime);"></i>View Open Play sign-ups &rarr;
                </a>
            </p>

            <script>
                (function () {
                    var typeSelect = document.getElementById('scheduleBlockType');
                    var fields = document.getElementById('publicSignupFields');
                    function sync() {
                        fields.style.display = typeSelect.value === '@BookingType.AdminHostedOpenPlay' ? '' : 'none';
                    }
                    typeSelect.addEventListener('change', sync);
                    sync();

                    // Handle type toggles inside each edit block modal
                    document.querySelectorAll('.edit-block-type-select').forEach(function (sel) {
                        var openPlayFields = sel.closest('form').querySelector('.open-play-fields');
                        function syncEdit() {
                            openPlayFields.classList.toggle('d-none', sel.value !== '@BookingType.AdminHostedOpenPlay');
                        }
                        sel.addEventListener('change', syncEdit);
                    });
                })();
            </script>

            <a asp-action="Courts" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Courts
            </a>

        </div>
    </div>
</div>
