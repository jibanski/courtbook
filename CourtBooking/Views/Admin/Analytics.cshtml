@{
    ViewData["Title"] = "Analytics";
    var settings = ViewBag.FacilitySettings as CourtBooking.Models.FacilitySettings;
    var courts   = ViewBag.Courts as List<CourtBooking.Models.Court> ?? new List<CourtBooking.Models.Court>();
    var defaultFrom = ViewBag.DefaultFrom as string;
    var defaultTo   = ViewBag.DefaultTo as string;
}

<div class="cb-page-header">
    <div class="container">
        <div class="cb-fade-up d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h1 class="mb-1" style="font-size:1.75rem;">
                    <i class="bi bi-graph-up-arrow me-2" style="color:var(--cb-lime);"></i>Real-Time Analytics
                </h1>
                <p style="color:var(--cb-text-2);font-size:.9rem;margin:0;">
                    Live booking and payment metrics for @(settings?.DisplayName ?? "your facility"). Auto-refreshes every 10s.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span id="analytics-live-dot" class="d-inline-block rounded-circle"
                      style="width:10px;height:10px;background:#22c55e;box-shadow:0 0 0 0 rgba(34,197,94,.7);
                             animation:pulse 1.5s infinite;"></span>
                <small id="analytics-updated" class="text-muted">Loading…</small>
            </div>
        </div>
    </div>
</div>

<div class="container">

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form id="analytics-filter-form" class="row g-2 align-items-end" onsubmit="return false;">
                <div class="col-sm-4 col-md-3">
                    <label class="form-label small fw-semibold">Court</label>
                    <select id="f-court" class="form-select form-select-sm">
                        <option value="">All Courts</option>
                        @foreach (var c in courts)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-sm-4 col-md-3">
                    <label class="form-label small fw-semibold">From (Payment Date)</label>
                    <input type="date" id="f-from" class="form-control form-control-sm" value="@defaultFrom" />
                </div>
                <div class="col-sm-4 col-md-3">
                    <label class="form-label small fw-semibold">To (Payment Date)</label>
                    <input type="date" id="f-to" class="form-control form-control-sm" value="@defaultTo" />
                </div>
                <div class="col-sm-12 col-md-3">
                    <button type="button" id="f-apply" class="btn btn-primary btn-sm w-100">
                        <i class="bi bi-funnel me-1"></i>Apply Filter
                    </button>
                </div>
                <div class="col-12">
                    <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Date range presets">
                        <button type="button" class="btn btn-outline-secondary preset-btn" data-preset="today">Today</button>
                        <button type="button" class="btn btn-outline-secondary preset-btn" data-preset="yesterday">Yesterday</button>
                        <button type="button" class="btn btn-outline-secondary preset-btn" data-preset="week">This Week</button>
                        <button type="button" class="btn btn-outline-secondary preset-btn" data-preset="month">This Month</button>
                        <button type="button" class="btn btn-outline-secondary preset-btn" data-preset="lastmonth">Last Month</button>
                        <button type="button" class="btn btn-outline-secondary preset-btn" data-preset="30d">Last 30 Days</button>
                    </div>
                </div>
                <div class="col-12">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>This range filters by when a booking was
                        <strong>paid</strong> (falling back to its court date only if still unpaid) &mdash; not by
                        the court's booking date. A booking paid a day ahead of its scheduled court date is
                        counted under the day it was paid, so totals here can differ from the same date on
                        <a asp-controller="Admin" asp-action="Bookings">All Bookings</a>, which always filters by
                        the court's booking date.
                    </small>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted small text-uppercase">Today</div>
                <div class="fs-3 fw-bold" id="m-todayBookings">—</div>
                <div class="small text-muted">bookings</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted small text-uppercase">Today's Revenue</div>
                <div class="fs-3 fw-bold text-success" id="m-todayRevenue">—</div>
                <div class="small text-muted">paid today</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted small text-uppercase">Awaiting Verification</div>
                <div class="fs-3 fw-bold text-warning" id="m-awaiting">—</div>
                <div class="small text-muted">manual proofs</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted small text-uppercase">Conversion <span id="lbl-conversion-range"></span></div>
                <div class="fs-3 fw-bold" id="m-conversion">—</div>
                <div class="small text-muted"><span id="m-paid30">0</span> paid / <span id="m-bookings30">0</span> total</div>
            </div></div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted small text-uppercase">Bookings <span id="lbl-rangebookings-range"></span></div>
                <div class="fs-3 fw-bold" id="m-rangeBookings">—</div>
                <div class="small text-muted">non-cancelled, selected range</div>
            </div></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card shadow-sm h-100"><div class="card-body">
                <div class="text-muted small text-uppercase">Revenue <span id="lbl-rangerevenue-range"></span></div>
                <div class="fs-3 fw-bold text-success" id="m-rangeRevenue">—</div>
                <div class="small text-muted">paid, selected range</div>
            </div></div>
        </div>
    </div>


    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-bar-chart-line me-2 text-primary"></i>Revenue <span id="lbl-revenue-range">— Last 30 Days</span>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" height="120"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-pie-chart-fill me-2 text-success"></i>Payment Methods <span id="lbl-methods-range">(30d)</span>
                </div>
                <div class="card-body">
                    <canvas id="methodChart" height="200"></canvas>
                    <div id="method-empty" class="text-center text-muted py-4 small d-none">
                        No paid bookings in the last 30 days yet.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-collection me-2"></i>All-Time
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-7 text-muted">Total bookings</dt>
                        <dd class="col-5 fw-bold text-end" id="m-totalBookings">—</dd>
                        <dt class="col-7 text-muted">Total revenue</dt>
                        <dd class="col-5 fw-bold text-end text-success" id="m-totalRevenue">—</dd>
                        <dt class="col-7 text-muted ps-3">— Court rentals</dt>
                        <dd class="col-5 text-end" id="m-courtRentalRevenue">—</dd>
                        <dt class="col-7 text-muted ps-3">— Add-ons</dt>
                        <dd class="col-5 text-end" id="m-addOnsRevenue">—</dd>
                        <dt class="col-7 text-muted">Pending (no proof)</dt>
                        <dd class="col-5 fw-bold text-end" id="m-pendingNoProof">—</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-list-check me-2"></i>Payment Mix <span id="lbl-mix-range">(30d)</span>
                    <i class="bi bi-info-circle text-muted small ms-1" title="Grouped by payment date, not court booking date."></i>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Method</th><th class="text-end">Bookings</th><th class="text-end">Revenue</th></tr>
                        </thead>
                        <tbody id="method-table"><tr><td colspan="3" class="text-center text-muted py-3">Loading…</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-clipboard-data me-2"></i>Status Breakdown <span id="lbl-status-range">(30d)</span>
                    <i class="bi bi-info-circle text-muted small ms-1" title="Grouped by payment date, not court booking date."></i>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Status</th><th class="text-end">Count</th><th class="text-end">Value</th></tr>
                        </thead>
                        <tbody id="status-table"><tr><td colspan="3" class="text-center text-muted py-3">Loading…</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-grid-3x3-gap me-2"></i>By Court <span id="lbl-court-range">(30d)</span>
                    <i class="bi bi-info-circle text-muted small ms-1" title="Grouped by payment date, not court booking date."></i>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Court</th><th class="text-end">Bookings</th><th class="text-end">Revenue</th></tr>
                        </thead>
                        <tbody id="court-table"><tr><td colspan="3" class="text-center text-muted py-3">Loading…</td></tr></tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-person-badge me-2"></i>By Staff <span id="lbl-staff-range">(30d)</span>
                    <i class="bi bi-info-circle text-muted small ms-1" title="Grouped by payment date, not court booking date."></i>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Staff</th><th class="text-end">Sales</th><th class="text-end">Revenue</th></tr>
                        </thead>
                        <tbody id="staff-table"><tr><td colspan="3" class="text-center text-muted py-3">Loading…</td></tr></tbody>
                    </table>
                    <div id="staff-empty" class="text-center text-muted py-3 small d-none">
                        No staff-logged sales in this range.
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-bag-check me-2"></i>Top Add-On Items <span id="lbl-addons-range">(30d)</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Item</th><th class="text-end">Qty</th><th class="text-end">Revenue</th></tr>
                        </thead>
                        <tbody id="addons-table"><tr><td colspan="3" class="text-center text-muted py-3">Loading…</td></tr></tbody>
                    </table>
                    <div id="addons-empty" class="text-center text-muted py-3 small d-none">
                        No add-ons sold in this range.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes pulse {
        0%   { box-shadow: 0 0 0 0   rgba(34,197,94,.7); }
        70%  { box-shadow: 0 0 0 8px rgba(34,197,94,0); }
        100% { box-shadow: 0 0 0 0   rgba(34,197,94,0); }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"
            crossorigin="anonymous"></script>
    <script>
        const peso = v => '₱' + (Number(v) || 0).toLocaleString('en-PH', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
        const methodColors = {
            'GCash': '#0ea5e9', 'Maya': '#22c55e', 'GrabPay': '#10b981',
            'QRPh': '#f59e0b', 'Online Banking': '#6366f1', 'BillEase': '#a855f7',
            'Card': '#111827', 'Unknown': '#94a3b8'
        };
        function colorFor(m) { return methodColors[m] || '#64748b'; }
        const statusColors = {
            'Confirmed': '#22c55e', 'Completed': '#0ea5e9', 'Pending': '#f59e0b', 'Cancelled': '#ef4444',
            'Refunded': '#a855f7', 'Partially Refunded': '#fd7e14'
        };
        function statusColorFor(s) { return statusColors[s] || '#64748b'; }

        let revenueChart, methodChart;

        function initCharts() {
            const ctx1 = document.getElementById('revenueChart').getContext('2d');
            revenueChart = new Chart(ctx1, {
                type: 'bar',
                data: { labels: [], datasets: [{ label: 'Revenue', data: [], backgroundColor: 'rgba(163,255,18,0.6)', borderColor: 'rgba(0,0,0,0.2)', borderWidth: 1 }] },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true, ticks: { callback: v => peso(v) } } },
                    plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => peso(c.parsed.y) } } }
                }
            });

            const ctx2 = document.getElementById('methodChart').getContext('2d');
            methodChart = new Chart(ctx2, {
                type: 'doughnut',
                data: { labels: [], datasets: [{ data: [], backgroundColor: [] }] },
                options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom' } } }
            });
        }

        function currentFilters() {
            const courtId = document.getElementById('f-court').value;
            const from    = document.getElementById('f-from').value;
            const to      = document.getElementById('f-to').value;
            const params  = new URLSearchParams();
            if (courtId) params.set('courtId', courtId);
            if (from)    params.set('from', from);
            if (to)      params.set('to', to);
            return params.toString();
        }

        let refreshInFlight = false;

        async function refresh() {
            // A slow/hung request (e.g. a large facility's history taking a while to
            // aggregate) must never let polls pile up on top of each other, or the page
            // can end up stuck showing the initial "Loading…" placeholders forever.
            if (refreshInFlight) return;
            refreshInFlight = true;
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 15000);
            try {
                const qs  = currentFilters();
                const res = await fetch('@Url.Action("AnalyticsData", "Admin")' + (qs ? '?' + qs : ''),
                    { credentials: 'same-origin', signal: controller.signal });
                if (!res.ok) throw new Error(res.status);
                const d = await res.json();

                const rangeLabel = `(${d.rangeFrom} to ${d.rangeTo})`;
                document.getElementById('lbl-revenue-range').textContent  = `— ${rangeLabel}`;
                document.getElementById('lbl-methods-range').textContent  = rangeLabel;
                document.getElementById('lbl-mix-range').textContent      = rangeLabel;
                document.getElementById('lbl-status-range').textContent   = rangeLabel;
                document.getElementById('lbl-conversion-range').textContent = rangeLabel;
                document.getElementById('lbl-rangebookings-range').textContent = rangeLabel;
                document.getElementById('lbl-rangerevenue-range').textContent  = rangeLabel;
                document.getElementById('lbl-court-range').textContent   = rangeLabel;
                document.getElementById('lbl-staff-range').textContent   = rangeLabel;
                document.getElementById('lbl-addons-range').textContent  = rangeLabel;

                document.getElementById('m-todayBookings').textContent  = d.counters.todayBookings;
                document.getElementById('m-todayRevenue').textContent   = peso(d.counters.todayRevenue);
                document.getElementById('m-awaiting').textContent       = d.counters.awaitingPayment;
                document.getElementById('m-conversion').textContent     = d.counters.conversionPct + '%';
                document.getElementById('m-paid30').textContent         = d.counters.paidInRange;
                document.getElementById('m-bookings30').textContent     = d.counters.bookingsInRange;
                document.getElementById('m-rangeBookings').textContent  = d.counters.bookingsInRange;
                document.getElementById('m-rangeRevenue').textContent   = peso(d.counters.rangeRevenue);
                document.getElementById('m-totalBookings').textContent  = d.counters.totalBookings;
                document.getElementById('m-totalRevenue').textContent   = peso(d.counters.totalRevenue);
                document.getElementById('m-courtRentalRevenue').textContent = peso(d.counters.courtRentalRevenue);
                document.getElementById('m-addOnsRevenue').textContent  = peso(d.counters.addOnsRevenue);
                document.getElementById('m-pendingNoProof').textContent = d.counters.pendingNoProof;

                if (revenueChart) {
                    revenueChart.data.labels = d.revenueByDay.map(r => r.date.slice(5));
                    revenueChart.data.datasets[0].data = d.revenueByDay.map(r => Number(r.revenue));
                    revenueChart.update('none');
                }

                const methods = d.methodBreakdown || [];
                document.getElementById('method-empty').classList.toggle('d-none', methods.length > 0);
                if (methodChart) {
                    methodChart.data.labels = methods.map(m => m.method);
                    methodChart.data.datasets[0].data = methods.map(m => m.count);
                    methodChart.data.datasets[0].backgroundColor = methods.map(m => colorFor(m.method));
                    methodChart.update('none');
                }

                const tbody = document.getElementById('method-table');
                tbody.innerHTML = methods.length === 0
                    ? '<tr><td colspan="3" class="text-center text-muted py-3">No paid bookings yet.</td></tr>'
                    : methods.map(m =>
                        `<tr>
                            <td><span class="badge" style="background:${colorFor(m.method)};">${m.method}</span></td>
                            <td class="text-end">${m.count}</td>
                            <td class="text-end">${peso(m.revenue)}</td>
                        </tr>`).join('');

                const statuses = d.statusBreakdown || [];
                const statusTbody = document.getElementById('status-table');
                statusTbody.innerHTML = statuses.length === 0
                    ? '<tr><td colspan="3" class="text-center text-muted py-3">No bookings in this range.</td></tr>'
                    : statuses.map(s =>
                        `<tr>
                            <td><span class="badge" style="background:${statusColorFor(s.status)};">${s.status}</span></td>
                            <td class="text-end">${s.count}</td>
                            <td class="text-end">${peso(s.revenue)}</td>
                        </tr>`).join('');

                const courts = d.courtBreakdown || [];
                document.getElementById('court-table').innerHTML = courts.length === 0
                    ? '<tr><td colspan="3" class="text-center text-muted py-3">No bookings in this range.</td></tr>'
                    : courts.map(c =>
                        `<tr>
                            <td>${c.court}</td>
                            <td class="text-end">${c.count}</td>
                            <td class="text-end">${peso(c.revenue)}</td>
                        </tr>`).join('');

                const staffRows = d.staffBreakdown || [];
                document.getElementById('staff-empty').classList.toggle('d-none', staffRows.length > 0);
                document.getElementById('staff-table').innerHTML = staffRows.length === 0
                    ? '<tr><td colspan="3" class="text-center text-muted py-3">No staff-logged sales.</td></tr>'
                    : staffRows.map(s =>
                        `<tr>
                            <td>${s.staff}</td>
                            <td class="text-end">${s.count}</td>
                            <td class="text-end">${peso(s.revenue)}</td>
                        </tr>`).join('');

                const addOns = d.topAddOnItems || [];
                document.getElementById('addons-empty').classList.toggle('d-none', addOns.length > 0);
                document.getElementById('addons-table').innerHTML = addOns.length === 0
                    ? '<tr><td colspan="3" class="text-center text-muted py-3">No add-ons sold.</td></tr>'
                    : addOns.map(a =>
                        `<tr>
                            <td>${a.name}</td>
                            <td class="text-end">${a.quantity}</td>
                            <td class="text-end">${peso(a.revenue)}</td>
                        </tr>`).join('');

                const t = new Date(d.generatedAt);
                document.getElementById('analytics-updated').textContent =
                    'Updated ' + t.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            } catch (e) {
                document.getElementById('analytics-updated').textContent = 'Update failed — retrying…';
            } finally {
                clearTimeout(timeout);
                refreshInFlight = false;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            try { initCharts(); } catch (e) { /* Chart.js failed to load — metrics/table still work without it */ }
            refresh();
            setInterval(refresh, 10000);
            document.getElementById('f-apply').addEventListener('click', refresh);

            // PHT-local date formatted as yyyy-MM-dd for the <input type=date> fields.
            const toDateInput = date => {
                const pht = new Date(date.getTime() + 8 * 3600 * 1000);
                return pht.toISOString().slice(0, 10);
            };
            document.querySelectorAll('.preset-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const now = new Date();
                    let from = new Date(now), to = new Date(now);
                    switch (btn.dataset.preset) {
                        case 'today':     break;
                        case 'yesterday': from.setUTCDate(from.getUTCDate() - 1); to = new Date(from); break;
                        case 'week': {
                            const phtDay = new Date(now.getTime() + 8 * 3600 * 1000).getUTCDay(); // 0=Sun..6=Sat
                            const diffToMonday = (phtDay + 6) % 7;
                            from.setUTCDate(from.getUTCDate() - diffToMonday);
                            break;
                        }
                        case 'month': {
                            const phtNow = new Date(now.getTime() + 8 * 3600 * 1000);
                            from = new Date(Date.UTC(phtNow.getUTCFullYear(), phtNow.getUTCMonth(), 1) - 8 * 3600 * 1000);
                            break;
                        }
                        case 'lastmonth': {
                            const phtNow = new Date(now.getTime() + 8 * 3600 * 1000);
                            from = new Date(Date.UTC(phtNow.getUTCFullYear(), phtNow.getUTCMonth() - 1, 1) - 8 * 3600 * 1000);
                            to   = new Date(Date.UTC(phtNow.getUTCFullYear(), phtNow.getUTCMonth(), 0) - 8 * 3600 * 1000);
                            break;
                        }
                        case '30d': from.setUTCDate(from.getUTCDate() - 29); break;
                    }
                    document.getElementById('f-from').value = toDateInput(from);
                    document.getElementById('f-to').value   = toDateInput(to);
                    refresh();
                });
            });
        });
    </script>
}
