@model List<CourtBooking.Models.CourtBlock>
@{
    ViewData["Title"] = "Block Multiple Courts";
    var courts     = ViewBag.Courts as List<CourtBooking.Models.Court> ?? new();
    var courtNames = ViewBag.BlockCourt as Dictionary<int, string> ?? new();
    var today      = PhtClock.Today;
    var todayStr   = today.ToString("yyyy-MM-dd");

    var upcoming = Model.Where(b => b.EndDate >= today).ToList();
    var past     = Model.Where(b => b.EndDate <  today).ToList();
}

<div class="cb-page-header">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-2">
            <ol class="breadcrumb mb-0" style="font-size:.8rem;">
                <li class="breadcrumb-item">
                    <a asp-action="Courts" style="color:var(--cb-text-3);text-decoration:none;">Courts</a>
                </li>
                <li class="breadcrumb-item active" style="color:var(--cb-text-2);">Block Multiple Courts</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-3">
            <span class="d-inline-flex align-items-center justify-content-center rounded-3"
                  style="width:48px;height:48px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.25);flex-shrink:0;">
                <i class="bi bi-slash-circle fs-4" style="color:#f87171;"></i>
            </span>
            <div>
                <h1 class="mb-0" style="font-size:1.5rem;font-weight:800;">Block Multiple Courts</h1>
                <p class="mb-0" style="color:var(--cb-text-3);font-size:.875rem;">
                    Close a date/time range across several courts in one go — maintenance, events, holidays, etc.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">

            @* ── Alerts ── *@
            @if (TempData["Success"] is string succ)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-check-circle-fill"></i> @succ
                </div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-exclamation-triangle-fill"></i> @err
                </div>
            }

            @* ── Add New Bulk Block ── *@
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0 fw-bold" style="font-size:.875rem;">
                        <i class="bi bi-plus-circle me-2" style="color:var(--cb-lime);"></i>Add Block Period
                    </h6>
                    <p class="mb-0 mt-1" style="font-size:.78rem;color:var(--cb-text-3);">
                        All hours between the start and end times will be unavailable for booking on every court you select.
                    </p>
                </div>
                <div class="card-body p-4">
                    @if (!courts.Any())
                    {
                        <p class="mb-0" style="color:var(--cb-text-3);font-size:.825rem;">
                            You don't have any courts yet.
                        </p>
                    }
                    else
                    {
                        <form asp-action="AddCourtBlockBulk" method="post" id="bulkBlockForm">
                            @Html.AntiForgeryToken()

                            @* ── Mode toggle ── *@
                            <div class="mb-3 d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="mode" value="same"
                                           id="mode-same" checked onchange="cbSwitchMode()" />
                                    <label class="form-check-label small fw-semibold" for="mode-same" style="color:var(--cb-text-2);">
                                        Same timing for all
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="mode" value="custom"
                                           id="mode-custom" onchange="cbSwitchMode()" />
                                    <label class="form-check-label small fw-semibold" for="mode-custom" style="color:var(--cb-text-2);">
                                        Different timing per court
                                    </label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <label class="form-label small fw-semibold mb-0" style="color:var(--cb-text-2);">Courts</label>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cbToggleAll(true)">Select All</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="cbToggleAll(false)">Clear</button>
                                    </div>
                                </div>
                                <div class="row g-2" id="cbSameCourtsList">
                                    @foreach (var c in courts)
                                    {
                                        <div class="col-sm-6 col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input cb-court-check" type="checkbox"
                                                       name="courtIds" value="@c.Id" id="court-@c.Id"
                                                       checked onchange="cbSyncCustomRow(@c.Id)" />
                                                <label class="form-check-label" for="court-@c.Id" style="font-size:.875rem;">
                                                    @c.Name
                                                    <span class="text-muted" style="font-size:.75rem;"> (@c.SportType)</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* ── "Same timing" inputs ── *@
                            <div class="row g-3" id="cbSameTimingFields">
                                @* Start *@
                                <div class="col-sm-6">
                                    <label class="form-label small fw-semibold" style="color:var(--cb-text-2);">Start Date</label>
                                    <input type="date" name="startDate" class="form-control"
                                           value="@todayStr" min="@todayStr" required />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small fw-semibold" style="color:var(--cb-text-2);">Start Hour</label>
                                    <select name="startHour" class="form-select">
                                        @for (int h = 0; h < 24; h++)
                                        {
                                            <option value="@h">@TimeDisplay.Hour(h)</option>
                                        }
                                    </select>
                                </div>

                                @* End *@
                                <div class="col-sm-6">
                                    <label class="form-label small fw-semibold" style="color:var(--cb-text-2);">End Date</label>
                                    <input type="date" name="endDate" class="form-control"
                                           value="@todayStr" min="@todayStr" required />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small fw-semibold" style="color:var(--cb-text-2);">End Hour</label>
                                    <select name="endHour" class="form-select">
                                        @for (int h = 1; h <= 24; h++)
                                        {
                                            <option value="@h" selected="@(h == 24)">@TimeDisplay.Hour(h)</option>
                                        }
                                    </select>
                                </div>

                                @* Reason *@
                                <div class="col-12">
                                    <label class="form-label small fw-semibold" style="color:var(--cb-text-2);">Reason <span class="text-muted fw-normal">(optional)</span></label>
                                    <input type="text" name="reason" class="form-control"
                                           placeholder="e.g. Maintenance, Private event, Public holiday…"
                                           maxlength="300" />
                                </div>
                            </div>

                            @* ── "Custom timing per court" rows ── *@
                            <div class="d-none" id="cbCustomTimingFields">
                                <div class="table-responsive">
                                    <table class="table table-sm align-middle">
                                        <thead>
                                            <tr style="font-size:.78rem;color:var(--cb-text-3);">
                                                <th>Court</th>
                                                <th>Start Date</th>
                                                <th>Start Hour</th>
                                                <th>End Date</th>
                                                <th>End Hour</th>
                                                <th>Reason</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in courts)
                                            {
                                                <tr id="cbCustomRow-@c.Id">
                                                    <td style="font-size:.85rem;white-space:nowrap;">@c.Name</td>
                                                    <td>
                                                        <input type="date" name="startDate_@c.Id" class="form-control form-control-sm"
                                                               value="@todayStr" min="@todayStr" style="min-width:135px;" />
                                                    </td>
                                                    <td>
                                                        <select name="startHour_@c.Id" class="form-select form-select-sm" style="min-width:100px;">
                                                            @for (int h = 0; h < 24; h++)
                                                            {
                                                                <option value="@h">@TimeDisplay.Hour(h)</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <input type="date" name="endDate_@c.Id" class="form-control form-control-sm"
                                                               value="@todayStr" min="@todayStr" style="min-width:135px;" />
                                                    </td>
                                                    <td>
                                                        <select name="endHour_@c.Id" class="form-select form-select-sm" style="min-width:100px;">
                                                            @for (int h = 1; h <= 24; h++)
                                                            {
                                                                <option value="@h" selected="@(h == 24)">@TimeDisplay.Hour(h)</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <input type="text" name="reason_@c.Id" class="form-control form-control-sm"
                                                               placeholder="Reason (optional)" maxlength="300" style="min-width:160px;" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <p class="mb-0" style="font-size:.78rem;color:var(--cb-text-3);">
                                    Only checked courts (above) are blocked — each row's own date/hour range applies to that court.
                                </p>
                            </div>

                            <div class="mt-3">
                                <button type="submit" class="btn btn-danger fw-semibold">
                                    <i class="bi bi-slash-circle me-1"></i>Block Selected Courts
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>

            @* ── Active / Upcoming Blocks ── *@
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h6 class="mb-0 fw-bold" style="font-size:.875rem;">
                        <i class="bi bi-calendar-x me-2" style="color:#f87171;"></i>Active &amp; Upcoming Blocks
                        @if (upcoming.Any())
                        {
                            <span class="badge ms-1" style="background:rgba(239,68,68,0.15);color:#f87171;font-size:.7rem;">@upcoming.Count</span>
                        }
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (!upcoming.Any())
                    {
                        <p class="p-4 mb-0" style="color:var(--cb-text-3);font-size:.825rem;">
                            <i class="bi bi-check-circle me-1" style="color:#4ade80;"></i>No active blocks — all courts are fully open.
                        </p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var blk in upcoming)
                            {
                                bool isOngoing = blk.StartDate <= today && blk.EndDate >= today;
                                <li class="list-group-item d-flex align-items-start justify-content-between gap-3 py-3">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="d-flex align-items-center justify-content-center rounded-2 flex-shrink-0"
                                             style="width:40px;height:40px;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);">
                                            <i class="bi bi-slash-circle" style="color:#f87171;"></i>
                                        </div>
                                        <div>
                                            <div class="fw-semibold" style="font-size:.9rem;">
                                                @(courtNames.TryGetValue(blk.CourtId, out var cn) ? cn : "Unknown court")
                                            </div>
                                            <div style="font-size:.8rem;color:var(--cb-text-3);">
                                                @blk.StartLabel
                                                <span> → </span>
                                                @blk.EndLabel
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(blk.Reason))
                                            {
                                                <div style="font-size:.8rem;color:var(--cb-text-3);">@blk.Reason</div>
                                            }
                                            <div class="mt-1 d-flex gap-2 flex-wrap">
                                                @if (isOngoing)
                                                {
                                                    <span class="badge" style="background:rgba(239,68,68,0.15);color:#f87171;font-size:.68rem;">
                                                        <i class="bi bi-record-circle me-1"></i>Ongoing
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge" style="background:rgba(251,191,36,0.15);color:#fbbf24;font-size:.68rem;">
                                                        <i class="bi bi-clock me-1"></i>Upcoming
                                                    </span>
                                                }
                                                @if (blk.IsSingleDay)
                                                {
                                                    <span class="badge" style="background:var(--cb-surface-2);color:var(--cb-text-3);font-size:.68rem;">Single day</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-column gap-2 flex-shrink-0">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Edit block"
                                                data-bs-toggle="modal" data-bs-target="#editBlockModal-@blk.Id">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form asp-action="DeleteCourtBlockBulk" method="post"
                                              onsubmit="return confirm('Remove this block? Customers will be able to book these hours again.')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@blk.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove block">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </li>

                                <div class="modal fade" id="editBlockModal-@blk.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content" style="background:var(--cb-surface);color:var(--cb-text);">
                                            <form asp-action="EditCourtBlockBulk" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@blk.Id" />
                                                <div class="modal-header" style="border-color:var(--cb-border);">
                                                    <h6 class="modal-title fw-bold" style="font-size:.9rem;">
                                                        Edit Block — @(courtNames.TryGetValue(blk.CourtId, out var ecn) ? ecn : "Unknown court")
                                                    </h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="row g-3">
                                                        <div class="col-sm-6">
                                                            <label class="form-label small fw-semibold" style="color:var(--cb-text-2);">Start Date</label>
                                                            <input type="date" name="startDate" class="form-control"
                                                                   value="@blk.StartDate.ToString("yyyy-MM-dd")" required />
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <label class="form-label small fw-semibold" style="color:var(--cb-text-2);">Start Hour</label>
                                                            <select name="startHour" class="form-select">
                                                                @for (int h = 0; h < 24; h++)
                                                                {
                                                                    <option value="@h" selected="@(h == blk.StartHour)">@TimeDisplay.Hour(h)</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <label class="form-label small fw-semibold" style="color:var(--cb-text-2);">End Date</label>
                                                            <input type="date" name="endDate" class="form-control"
                                                                   value="@blk.EndDate.ToString("yyyy-MM-dd")" required />
                                                        </div>
                                                        <div class="col-sm-6">
                                                            <label class="form-label small fw-semibold" style="color:var(--cb-text-2);">End Hour</label>
                                                            <select name="endHour" class="form-select">
                                                                @for (int h = 1; h <= 24; h++)
                                                                {
                                                                    <option value="@h" selected="@(h == blk.EndHour)">@TimeDisplay.Hour(h)</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-12">
                                                            <label class="form-label small fw-semibold" style="color:var(--cb-text-2);">Reason <span class="text-muted fw-normal">(optional)</span></label>
                                                            <input type="text" name="reason" class="form-control"
                                                                   value="@blk.Reason" maxlength="300" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer" style="border-color:var(--cb-border);">
                                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger fw-semibold">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </ul>
                    }
                </div>
            </div>

            @* ── Past Blocks (collapsed) ── *@
            @if (past.Any())
            {
                <div class="card mb-4">
                    <div class="card-header" style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#pastBlocksBulk">
                        <h6 class="mb-0 fw-bold d-flex align-items-center justify-content-between" style="font-size:.875rem;">
                            <span>
                                <i class="bi bi-clock-history me-2" style="color:var(--cb-text-3);"></i>Past Blocks
                                <span class="badge ms-1" style="background:var(--cb-surface-2);color:var(--cb-text-3);font-size:.7rem;">@past.Count</span>
                            </span>
                            <i class="bi bi-chevron-down" style="color:var(--cb-text-3);font-size:.75rem;"></i>
                        </h6>
                    </div>
                    <div id="pastBlocksBulk" class="collapse">
                        <ul class="list-group list-group-flush">
                            @foreach (var blk in past)
                            {
                                <li class="list-group-item d-flex align-items-center justify-content-between gap-3 py-3"
                                    style="opacity:.65;">
                                    <div>
                                        <div class="fw-semibold" style="font-size:.875rem;color:var(--cb-text-2);">
                                            @(courtNames.TryGetValue(blk.CourtId, out var cn2) ? cn2 : "Unknown court") —
                                            @blk.StartLabel → @blk.EndLabel
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(blk.Reason))
                                        {
                                            <div style="font-size:.78rem;color:var(--cb-text-3);">@blk.Reason</div>
                                        }
                                    </div>
                                    <form asp-action="DeleteCourtBlockBulk" method="post"
                                          onsubmit="return confirm('Delete this past block record?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@blk.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Delete record">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <div class="d-flex gap-2">
                <a asp-action="Courts" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back to Courts
                </a>
            </div>

        </div>
    </div>
</div>

<script>
    function cbToggleAll(checked) {
        document.querySelectorAll('.cb-court-check').forEach(cb => cb.checked = checked);
    }

    function cbSwitchMode() {
        var custom = document.getElementById('mode-custom').checked;
        document.getElementById('cbSameTimingFields').classList.toggle('d-none', custom);
        document.getElementById('cbCustomTimingFields').classList.toggle('d-none', !custom);
    }

    // Dim a court's custom-timing row when its checkbox is unchecked, so it's clear
    // that row won't be submitted even though its inputs remain in the form.
    function cbSyncCustomRow(courtId) {
        var checkbox = document.getElementById('court-' + courtId);
        var row = document.getElementById('cbCustomRow-' + courtId);
        if (checkbox && row) row.style.opacity = checkbox.checked ? '1' : '.4';
    }
</script>
