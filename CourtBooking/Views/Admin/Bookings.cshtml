@model IEnumerable<CourtBooking.Models.Booking>
@{
    ViewData["Title"] = "All Bookings";
    var selectedStatus       = ViewBag.SelectedStatus as string;
    var selectedDateFrom     = ViewBag.SelectedDateFrom as DateOnly?;
    var selectedDateTo       = ViewBag.SelectedDateTo as DateOnly?;
    var search               = ViewBag.Search as string;
    bool awaitingMode        = ViewBag.AwaitingConfirmation == true;
    int  pendingPaymentCount = (int)(ViewBag.PendingPaymentCount ?? 0);
    var rows = ViewBag.Rows as List<CourtBooking.ViewModels.AdminBookingRow>;
    var awaitingSignups = ViewBag.AwaitingSignups as List<CourtBooking.Models.OpenPlaySignup> ?? new();

    bool calendarView       = string.Equals(Context.Request.Query["view"], "calendar", StringComparison.OrdinalIgnoreCase);
    var calendarWeekStart   = ViewBag.CalendarWeekStart as DateOnly? ?? default;
    var calendarWeekEnd     = calendarWeekStart.AddDays(6);
    var calendarRows        = ViewBag.CalendarRows as List<CourtBooking.ViewModels.AdminBookingRow> ?? new();

    string StatusCls(CourtBooking.Models.BookingStatus st) => st switch
    {
        CourtBooking.Models.BookingStatus.Confirmed => "bg-success text-white",
        CourtBooking.Models.BookingStatus.Cancelled => "bg-danger text-white",
        CourtBooking.Models.BookingStatus.Completed => "bg-secondary text-white",
        _ => "bg-warning text-dark"
    };
}

<div class="bg-dark text-white py-4 mb-4">
    <div class="container">
        <h1 class="fw-bold mb-1"><i class="bi bi-calendar3 me-2"></i>All Bookings</h1>
    </div>
</div>

<div class="container">

    <!-- Tab bar -->
    <div class="d-flex gap-2 mb-4 flex-wrap">
        <a asp-action="Bookings" class="btn @(!awaitingMode ? "btn-primary" : "btn-outline-secondary")">
            <i class="bi bi-list-ul me-1"></i>All Bookings
        </a>
        <a asp-action="Bookings" asp-route-awaitingConfirmation="true"
           class="btn @(awaitingMode ? "btn-danger" : "btn-outline-danger") position-relative">
            <i class="bi bi-hourglass-split me-1"></i>Awaiting Confirmation
            @if (pendingPaymentCount > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @pendingPaymentCount
                </span>
            }
        </a>
    </div>

    @if (!awaitingMode)
    {
        <!-- List / Calendar view toggle -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div class="btn-group" role="group">
                <a href="@Url.Action("Bookings", new { status = selectedStatus, dateFrom = selectedDateFrom, dateTo = selectedDateTo, search })"
                   class="btn btn-sm @(!calendarView ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-list-ul me-1"></i>List View
                </a>
                <a href="@Url.Action("Bookings", calendarView ? new { view = "calendar", weekStart = calendarWeekStart.ToString("yyyy-MM-dd") } : new { view = "calendar" })"
                   class="btn btn-sm @(calendarView ? "btn-primary" : "btn-outline-primary")">
                    <i class="bi bi-calendar-week me-1"></i>Calendar View
                </a>
            </div>

            @if (calendarView)
            {
                <div class="d-flex align-items-center gap-2">
                    <a href="@Url.Action("Bookings", new { view = "calendar", weekStart = calendarWeekStart.AddDays(-7).ToString("yyyy-MM-dd") })"
                       class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-left"></i></a>
                    <span class="fw-semibold small text-nowrap">
                        @calendarWeekStart.ToString("MMM d") – @calendarWeekEnd.ToString("MMM d, yyyy")
                    </span>
                    <a href="@Url.Action("Bookings", new { view = "calendar", weekStart = calendarWeekStart.AddDays(7).ToString("yyyy-MM-dd") })"
                       class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-right"></i></a>
                    <a href="@Url.Action("Bookings", new { view = "calendar" })" class="btn btn-sm btn-outline-secondary">Today</a>
                </div>
            }
        </div>
    }

    @if (!awaitingMode && !calendarView)
    {
        <!-- Filters (shown only in all-bookings mode) -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <p class="text-muted small mb-3">
                    <i class="bi bi-info-circle me-1"></i>Showing the last 30 days by default — clear the date fields to see full history.
                </p>
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-sm-3">
                        <label class="form-label fw-semibold">Search</label>
                        <input type="text" name="search" class="form-control" placeholder="Customer name or phone" value="@search" />
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label fw-semibold">Status</label>
                        <select name="status" class="form-select">
                            <option value="">All Statuses</option>
                            @foreach (var s in Enum.GetNames<CourtBooking.Models.BookingStatus>())
                            {
                                <option value="@s" selected="@(selectedStatus == s)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label fw-semibold">From</label>
                        <input type="date" name="dateFrom" class="form-control" value="@selectedDateFrom?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label fw-semibold">To</label>
                        <input type="date" name="dateTo" class="form-control" value="@selectedDateTo?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-sm-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel me-1"></i>Filter
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Export -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-download me-2"></i>Export to CSV</h6>
                <form method="get" asp-action="ExportBookings" class="row g-3 align-items-end">
                    <div class="col-sm-3">
                        <label class="form-label small fw-semibold">Status</label>
                        <select name="status" class="form-select">
                            <option value="">All Statuses</option>
                            @foreach (var s in Enum.GetNames<CourtBooking.Models.BookingStatus>())
                            {
                                <option value="@s" selected="@(selectedStatus == s)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label small fw-semibold">From</label>
                        <input type="date" name="dateFrom" class="form-control" value="@selectedDateFrom?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label small fw-semibold">To</label>
                        <input type="date" name="dateTo" class="form-control" value="@selectedDateTo?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-sm-3">
                        <button type="submit" class="btn btn-outline-primary w-100">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (calendarView && !awaitingMode)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between">
                <span class="fw-bold">@calendarRows.Count booking(s) this week</span>
            </div>
            <div class="card-body p-2">
                <div class="calendar-grid">
                    @for (var d = calendarWeekStart; d <= calendarWeekEnd; d = d.AddDays(1))
                    {
                        var day = d;
                        var dayRows = calendarRows.Where(r => r.BookingDate == day).ToList();
                        <div class="calendar-day-col @(day == CourtBooking.Helpers.PhtClock.Today ? "calendar-day-today" : "")">
                            <div class="calendar-day-header">
                                <div class="fw-bold small">@day.ToString("ddd")</div>
                                <div class="text-muted" style="font-size:.7rem;">@day.ToString("MMM d")</div>
                            </div>
                            <div class="calendar-day-body">
                                @if (dayRows.Count == 0)
                                {
                                    <div class="text-muted fst-italic text-center py-3" style="font-size:.7rem;">No bookings</div>
                                }
                                else
                                {
                                    @foreach (var b in dayRows)
                                    {
                                        <button type="button" class="calendar-event btn @StatusCls(b.Status)"
                                                data-bs-toggle="modal" data-bs-target="#bookingDetailModal"
                                                data-id="@b.Id"
                                                data-is-open-play="@b.IsOpenPlay.ToString().ToLowerInvariant()"
                                                data-customer="@b.CustomerName"
                                                data-is-guest="@b.IsGuest.ToString().ToLowerInvariant()"
                                                data-phone="@b.CustomerPhone"
                                                data-court="@b.CourtName"
                                                data-bundle="@b.BundleName"
                                                data-spot-count="@b.SpotCount"
                                                data-player-names="@b.PlayerNames"
                                                data-date-time="@($"{b.BookingDate:MMM d, yyyy} {b.StartTime:h:mm tt}–{b.EndTime:h:mm tt}")"
                                                data-rental="@((b.TotalPrice - b.AddOnsTotal).ToString("N0"))"
                                                data-addons-total="@b.AddOnsTotal.ToString("N0")"
                                                data-addons-summary="@b.AddOnsSummary"
                                                data-total="@b.TotalPrice.ToString("N0")"
                                                data-status="@b.Status"
                                                data-payment-status="@b.PaymentStatus"
                                                data-method="@b.PaymentMethod"
                                                data-reference="@b.PaymentReference"
                                                data-proof="@b.PaymentProofPath"
                                                data-booked-by="@(b.BookedByStaffName ?? "Online")"
                                                data-created="@b.CreatedAt.AddHours(8).ToString("MMM d, yyyy h:mm tt")">
                                            <div class="fw-semibold" style="font-size:.7rem;">@b.StartTime.ToString("h:mmtt")–@b.EndTime.ToString("h:mmtt")</div>
                                            <div class="text-truncate" style="font-size:.7rem;">@b.CourtName</div>
                                            <div class="text-truncate fw-semibold" style="font-size:.7rem;">@b.CustomerName</div>
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else if (awaitingMode && !Model.Any() && !awaitingSignups.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-check-circle display-1 text-success opacity-50"></i>
            <h4 class="mt-3 text-muted">No pending confirmations</h4>
            <p class="text-muted">All payment submissions have been reviewed.</p>
        </div>
    }
    else if (!awaitingMode && (rows is null || rows.Count == 0))
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted opacity-50"></i>
            <h4 class="mt-3 text-muted">No bookings found</h4>
            <p class="text-muted">Try adjusting the filters above.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between">
                <span class="fw-bold">@(awaitingMode ? Model.Count() + awaitingSignups.Count : rows!.Count) booking(s) found</span>
            </div>

            @if (awaitingMode)
            {
                <!-- Card layout for awaiting confirmation -->
                <div class="card-body">
                    @{ var renderedGroups = new HashSet<Guid>(); }
                    <div class="row g-3">
                        @foreach (var b in Model)
                        {
                            if (b.BundleGroupId is { } gid)
                            {
                                if (renderedGroups.Contains(gid)) { continue; }
                                renderedGroups.Add(gid);
                                var groupRows = Model.Where(x => x.BundleGroupId == gid)
                                    .OrderBy(x => x.BookingDate).ThenBy(x => x.StartTime).ToList();
                                var groupFirst = groupRows[0];
                                var groupTotal = groupRows.Sum(r => r.TotalPrice);
                                <div class="col-lg-6">
                                    <div class="card border-warning border-2 h-100" style="box-shadow:0 0 0 1px rgba(163,255,18,0.25) inset;">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <span class="fw-bold"><i class="bi bi-box-seam me-1"></i>@groupRows.Count slot@(groupRows.Count != 1 ? "s" : "") Booking</span>
                                                    <span class="badge bg-warning text-dark ms-2">Pending</span>
                                                </div>
                                                <span class="fw-bold text-success">₱@groupTotal.ToString("N0")</span>
                                            </div>
                                            <div class="mb-2 small">
                                                <div><i class="bi bi-person me-1 text-muted"></i><strong>@(groupFirst.CustomerNameSnapshot ?? groupFirst.User.FullName)</strong> (@groupFirst.User.Email)
                                                    @if (groupFirst.User.IsGuest) { <span class="badge bg-secondary ms-1">Guest</span> }
                                                </div>
                                                @foreach (var row in groupRows)
                                                {
                                                    <div><i class="bi bi-calendar me-1 text-muted"></i>@row.Court.Name &bull; @row.BookingDate.ToString("MMM d, yyyy") @row.StartTime.ToString("hh:mm tt")–@row.EndTime.ToString("hh:mm tt")</div>
                                                }
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(groupFirst.PaymentMethod) || !string.IsNullOrWhiteSpace(groupFirst.PaymentReference))
                                            {
                                                <div class="border rounded p-2 bg-light mb-2 small">
                                                    @if (!string.IsNullOrWhiteSpace(groupFirst.PaymentMethod))
                                                    {
                                                        <div><i class="bi bi-phone me-1"></i><strong>Method:</strong> @groupFirst.PaymentMethod</div>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(groupFirst.PaymentReference))
                                                    {
                                                        <div><i class="bi bi-hash me-1"></i><strong>Ref:</strong> @groupFirst.PaymentReference</div>
                                                    }
                                                    @if (groupFirst.PaymentProofSubmittedAt.HasValue)
                                                    {
                                                        <div class="text-muted"><i class="bi bi-clock me-1"></i>Submitted @groupFirst.PaymentProofSubmittedAt.Value.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                                                    }
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(groupFirst.PaymentProofPath))
                                            {
                                                <div class="mb-2">
                                                    <a href="@groupFirst.PaymentProofPath" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                        <i class="bi bi-image me-1"></i>View Screenshot
                                                    </a>
                                                </div>
                                            }

                                            <div class="d-flex gap-2">
                                                <form asp-action="ConfirmBundlePayment" asp-route-groupId="@gid" method="post" class="flex-fill">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success btn-sm w-100"
                                                            onclick="return confirm('Confirm this booking?')">
                                                        <i class="bi bi-check-circle me-1"></i>Confirm
                                                    </button>
                                                </form>
                                                <form asp-action="RejectBundlePayment" asp-route-groupId="@gid" method="post" class="flex-fill">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-danger btn-sm w-100"
                                                            onclick="return confirm('Reject and cancel this booking?')">
                                                        <i class="bi bi-x-circle me-1"></i>Reject
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                continue;
                            }
                            <div class="col-lg-6">
                                <div class="card border-warning border-2 h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <span class="fw-bold">Booking #@b.Id</span>
                                                <span class="badge bg-warning text-dark ms-2">Pending</span>
                                            </div>
                                            <span class="fw-bold text-success">₱@b.TotalPrice.ToString("N0")</span>
                                        </div>
                                        <div class="mb-2 small">
                                            <div><i class="bi bi-person me-1 text-muted"></i><strong>@(b.CustomerNameSnapshot ?? b.User.FullName)</strong> (@b.User.Email)
                                                @if (b.User.IsGuest) { <span class="badge bg-secondary ms-1">Guest</span> }
                                            </div>
                                            <div><i class="bi bi-buildings me-1 text-muted"></i>@b.Court.Name — @b.Court.SportType</div>
                                            <div><i class="bi bi-calendar me-1 text-muted"></i>@b.BookingDate.ToString("MMM d, yyyy") @b.StartTime.ToString("hh:mm tt")–@b.EndTime.ToString("hh:mm tt")</div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(b.PaymentMethod) || !string.IsNullOrWhiteSpace(b.PaymentReference))
                                        {
                                            <div class="border rounded p-2 bg-light mb-2 small">
                                                @if (!string.IsNullOrWhiteSpace(b.PaymentMethod))
                                                {
                                                    <div><i class="bi bi-phone me-1"></i><strong>Method:</strong> @b.PaymentMethod</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(b.PaymentReference))
                                                {
                                                    <div><i class="bi bi-hash me-1"></i><strong>Ref:</strong> @b.PaymentReference</div>
                                                }
                                                @if (b.PaymentProofSubmittedAt.HasValue)
                                                {
                                                    <div class="text-muted"><i class="bi bi-clock me-1"></i>Submitted @b.PaymentProofSubmittedAt.Value.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                                                }
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(b.PaymentProofPath))
                                        {
                                            <div class="mb-2">
                                                <a href="@b.PaymentProofPath" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-image me-1"></i>View Screenshot
                                                </a>
                                            </div>
                                        }

                                        <div class="d-flex gap-2">
                                            <form asp-action="ConfirmPayment" asp-route-id="@b.Id" method="post" class="flex-fill">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success btn-sm w-100"
                                                        onclick="return confirm('Confirm payment for Booking #@b.Id?')">
                                                    <i class="bi bi-check-circle me-1"></i>Confirm
                                                </button>
                                            </form>
                                            <form asp-action="RejectPayment" asp-route-id="@b.Id" method="post" class="flex-fill">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm w-100"
                                                        onclick="return confirm('Reject and cancel Booking #@b.Id?')">
                                                    <i class="bi bi-x-circle me-1"></i>Reject
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @foreach (var s in awaitingSignups)
                        {
                            <div class="col-lg-6">
                                <div class="card border-warning border-2 h-100" style="box-shadow:0 0 0 1px rgba(163,255,18,0.25) inset;">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <span class="fw-bold"><i class="bi bi-people me-1"></i>Open Play Sign-up #@s.Id</span>
                                                <span class="badge bg-warning text-dark ms-2">Pending</span>
                                            </div>
                                            <span class="fw-bold text-success">₱@s.TotalPrice.ToString("N0")</span>
                                        </div>
                                        <div class="mb-2 small">
                                            <div><i class="bi bi-person me-1 text-muted"></i><strong>@(s.CustomerNameSnapshot ?? s.User.FullName)</strong> (@s.User.Email)
                                                @if (s.User.IsGuest) { <span class="badge bg-secondary ms-1">Guest</span> }
                                            </div>
                                            <div><i class="bi bi-buildings me-1 text-muted"></i>@s.Court.Name — Open Play</div>
                                            <div><i class="bi bi-calendar me-1 text-muted"></i>@s.BookingDate.ToString("MMM d, yyyy") @TimeDisplay.HourRange(s.StartHour, s.EndHour)</div>
                                            <div><i class="bi bi-person-bounding-box me-1 text-muted"></i>@s.SpotCount spot@(s.SpotCount != 1 ? "s" : "")</div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(s.PaymentMethod) || !string.IsNullOrWhiteSpace(s.PaymentReference))
                                        {
                                            <div class="border rounded p-2 bg-light mb-2 small">
                                                @if (!string.IsNullOrWhiteSpace(s.PaymentMethod))
                                                {
                                                    <div><i class="bi bi-phone me-1"></i><strong>Method:</strong> @s.PaymentMethod</div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(s.PaymentReference))
                                                {
                                                    <div><i class="bi bi-hash me-1"></i><strong>Ref:</strong> @s.PaymentReference</div>
                                                }
                                                @if (s.PaymentProofSubmittedAt.HasValue)
                                                {
                                                    <div class="text-muted"><i class="bi bi-clock me-1"></i>Submitted @s.PaymentProofSubmittedAt.Value.ToLocalTime().ToString("MMM d, h:mm tt")</div>
                                                }
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(s.PaymentProofPath))
                                        {
                                            <div class="mb-2">
                                                <a href="@s.PaymentProofPath" target="_blank" class="btn btn-sm btn-outline-secondary">
                                                    <i class="bi bi-image me-1"></i>View Screenshot
                                                </a>
                                            </div>
                                        }

                                        <div class="d-flex gap-2">
                                            <form asp-action="ConfirmSignupPayment" asp-route-id="@s.Id" method="post" class="flex-fill">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success btn-sm w-100"
                                                        onclick="return confirm('Confirm payment for Open Play Sign-up #@s.Id?')">
                                                    <i class="bi bi-check-circle me-1"></i>Confirm
                                                </button>
                                            </form>
                                            <form asp-action="RejectSignupPayment" asp-route-id="@s.Id" method="post" class="flex-fill">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger btn-sm w-100"
                                                        onclick="return confirm('Reject and cancel Open Play Sign-up #@s.Id?')">
                                                    <i class="bi bi-x-circle me-1"></i>Reject
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- Table layout for all bookings -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle table-sm mb-0" style="font-size:.8125rem;">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Customer</th>
                                <th>Court</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Total</th>
                                <th>Payment</th>
                                <th>Status</th>
                                <th>Booked By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in rows!)
                            {
                                // Colors the status <select> itself so it doubles as the status badge — no separate columns needed.
                                var selectCls = b.Status switch {
                                    CourtBooking.Models.BookingStatus.Confirmed => "bg-success text-white",
                                    CourtBooking.Models.BookingStatus.Cancelled => "bg-danger text-white",
                                    CourtBooking.Models.BookingStatus.Completed => "bg-secondary text-white",
                                    _ => "bg-warning text-dark"
                                };
                                <tr>
                                    <td class="text-muted small">@b.Id</td>
                                    <td>
                                        <div class="fw-semibold">
                                            @b.CustomerName
                                            @if (b.IsGuest) { <span class="badge bg-secondary ms-1" style="font-size:.65rem;">Guest</span> }
                                        </div>
                                        <small class="text-muted">@b.CustomerPhone</small>
                                        @if (b.PlayerNames is not null)
                                        {
                                            <div class="small text-muted">with @b.PlayerNames</div>
                                        }
                                    </td>
                                    <td>
                                        @b.CourtName
                                        @if (b.BundleName is not null)
                                        {
                                            <span class="badge bg-info text-dark ms-1" title="Part of a bundled booking">
                                                <i class="bi bi-box-seam"></i> @b.BundleName
                                            </span>
                                        }
                                        @if (b.IsOpenPlay)
                                        {
                                            <span class="badge bg-primary-subtle text-primary-emphasis ms-1" title="Open Play sign-up">
                                                <i class="bi bi-people"></i> Open Play &middot; @b.SpotCount spot@(b.SpotCount != 1 ? "s" : "")
                                            </span>
                                        }
                                    </td>
                                    <td>@b.BookingDate.ToString("MMM d, yyyy")</td>
                                    <td>@b.StartTime.ToString("hh:mm tt") – @b.EndTime.ToString("hh:mm tt")</td>
                                    <td>
                                        <div class="fw-semibold">₱@b.TotalPrice.ToString("N0")</div>
                                        @if (b.AddOnsSummary is not null)
                                        {
                                            <div class="text-muted text-nowrap" style="font-size:.7rem;" title="@b.AddOnsSummary">
                                                Court ₱@((b.TotalPrice - b.AddOnsTotal).ToString("N0")) + Add-ons ₱@b.AddOnsTotal.ToString("N0")
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        @if (b.PaymentStatus == CourtBooking.Models.PaymentStatus.Paid)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check me-1"></i>Paid</span>
                                        }
                                        else if (b.HasPaymentProof)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Submitted</span>
                                        }
                                        else if (b.PaymentStatus == CourtBooking.Models.PaymentStatus.Refunded)
                                        {
                                            <span class="badge bg-secondary">Refunded</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">Unpaid</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(b.PaymentProofPath))
                                        {
                                            <div><a href="@b.PaymentProofPath" target="_blank" style="font-size:.7rem;">View proof</a></div>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="@(b.IsOpenPlay ? "UpdateSignupStatus" : "UpdateBookingStatus")" asp-route-id="@b.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <select name="status" class="form-select form-select-sm @selectCls" style="width:110px; font-size:.75rem; padding-top:.15rem; padding-bottom:.15rem;" data-current="@b.Status"
                                                    onchange="if (confirm('Change booking #@b.Id status to ' + this.value + '?')) { this.form.submit(); } else { this.value = this.dataset.current; }">
                                                @foreach (var s in Enum.GetValues<CourtBooking.Models.BookingStatus>())
                                                {
                                                    <option value="@s" selected="@(b.Status == s)">@s</option>
                                                }
                                            </select>
                                        </form>
                                    </td>
                                    <td>
                                        @if (b.BookedByStaffName is not null)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis" title="Logged by front-desk staff">
                                                <i class="bi bi-person-badge me-1"></i>@b.BookedByStaffName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Online</span>
                                        }
                                        <div class="text-muted text-nowrap" style="font-size:.7rem;">@b.CreatedAt.AddHours(8).ToString("MMM d, h:mm tt")</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

<!-- Shared booking detail modal (used by the Calendar View's clickable events) -->
<div class="modal fade" id="bookingDetailModal" tabindex="-1" aria-hidden="true"
     data-update-booking-url="@Url.Action("UpdateBookingStatus")"
     data-update-signup-url="@Url.Action("UpdateSignupStatus")">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Booking #<span id="bdId"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <span id="bdStatusBadge" class="badge"></span>
                    <span id="bdBundleBadge" class="badge bg-info text-dark ms-1 d-none"><i class="bi bi-box-seam"></i> <span id="bdBundleName"></span></span>
                    <span id="bdOpenPlayBadge" class="badge bg-primary-subtle text-primary-emphasis ms-1 d-none"><i class="bi bi-people"></i> Open Play</span>
                </div>
                <div class="mb-2 small">
                    <div><i class="bi bi-person me-1 text-muted"></i><strong id="bdCustomer"></strong>
                        <span id="bdGuestBadge" class="badge bg-secondary ms-1 d-none">Guest</span>
                    </div>
                    <div id="bdPhoneRow" class="d-none"><i class="bi bi-telephone me-1 text-muted"></i><span id="bdPhone"></span></div>
                    <div id="bdPlayerNamesRow" class="d-none text-muted"><i class="bi bi-person-bounding-box me-1"></i>with <span id="bdPlayerNames"></span></div>
                    <div><i class="bi bi-buildings me-1 text-muted"></i><span id="bdCourt"></span></div>
                    <div><i class="bi bi-calendar me-1 text-muted"></i><span id="bdDateTime"></span></div>
                </div>
                <div class="border rounded p-2 bg-light mb-2 small">
                    <div><strong>Court rental:</strong> ₱<span id="bdRental"></span></div>
                    <div id="bdAddOnsRow" class="d-none"><strong>Add-ons:</strong> <span id="bdAddOnsSummary"></span> (₱<span id="bdAddOnsTotal"></span>)</div>
                    <div><strong>Total:</strong> ₱<span id="bdTotal"></span></div>
                </div>
                <div class="border rounded p-2 bg-light mb-2 small">
                    <div><strong>Payment status:</strong> <span id="bdPaymentStatus"></span></div>
                    <div id="bdMethodRow" class="d-none"><i class="bi bi-phone me-1"></i><strong>Method:</strong> <span id="bdMethod"></span></div>
                    <div id="bdRefRow" class="d-none"><i class="bi bi-hash me-1"></i><strong>Ref:</strong> <span id="bdReference"></span></div>
                </div>
                <div id="bdProofRow" class="mb-2 d-none">
                    <a id="bdProofLink" href="#" target="_blank" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-image me-1"></i>View Payment Proof
                    </a>
                </div>
                <div class="small text-muted">
                    <i class="bi bi-person-badge me-1"></i>Booked by: <span id="bdBookedBy"></span>
                    &bull; <i class="bi bi-clock-history me-1"></i>Booked on: <span id="bdCreated"></span>
                </div>
            </div>
            <div class="modal-footer">
                <form id="bdStatusForm" method="post" class="d-flex gap-2 w-100">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="bdStatusId" />
                    <select name="status" id="bdStatusSelect" class="form-select form-select-sm" style="max-width:160px;">
                        @foreach (var s2 in Enum.GetValues<CourtBooking.Models.BookingStatus>())
                        {
                            <option value="@s2">@s2</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary btn-sm">Update Status</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm ms-auto" data-bs-dismiss="modal">Close</button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .calendar-grid {
        display: flex;
        gap: .5rem;
        overflow-x: auto;
        padding-bottom: .5rem;
    }

    .calendar-day-col {
        flex: 0 0 150px;
        border: 1px solid #e5e5e5;
        border-radius: .375rem;
        display: flex;
        flex-direction: column;
    }

    .calendar-day-today {
        border-color: #A3FF12;
        box-shadow: 0 0 0 1px #A3FF12;
    }

    .calendar-day-header {
        text-align: center;
        padding: .4rem .25rem;
        border-bottom: 1px solid #e5e5e5;
        background: #f8f9fa;
    }

    .calendar-day-body {
        flex: 1;
        padding: .35rem;
        min-height: 220px;
    }

    .calendar-event {
        display: block;
        width: 100%;
        text-align: left;
        border: none;
        border-radius: .25rem;
        padding: .3rem .4rem;
        margin-bottom: .3rem;
        line-height: 1.15;
    }
</style>

@section Scripts {
<script>
    (function () {
        var modalEl = document.getElementById('bookingDetailModal');
        if (!modalEl) return;

        modalEl.addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            if (!btn) return;
            var d = btn.dataset;

            document.getElementById('bdId').textContent = d.id;

            var statusBadge = document.getElementById('bdStatusBadge');
            statusBadge.textContent = d.status;
            statusBadge.className = 'badge ' + ({
                Confirmed: 'bg-success', Cancelled: 'bg-danger', Completed: 'bg-secondary'
            }[d.status] || 'bg-warning text-dark');

            toggle('bdBundleBadge', !!d.bundle);
            if (d.bundle) { document.getElementById('bdBundleName').textContent = d.bundle; }
            toggle('bdOpenPlayBadge', d.isOpenPlay === 'true');

            document.getElementById('bdCustomer').textContent = d.customer;
            toggle('bdGuestBadge', d.isGuest === 'true');
            toggle('bdPhoneRow', !!d.phone);
            document.getElementById('bdPhone').textContent = d.phone || '';
            toggle('bdPlayerNamesRow', !!d.playerNames);
            document.getElementById('bdPlayerNames').textContent = d.playerNames || '';

            var courtText = d.court + (d.spotCount ? ' — ' + d.spotCount + ' spot' + (d.spotCount !== '1' ? 's' : '') : '');
            document.getElementById('bdCourt').textContent = courtText;
            document.getElementById('bdDateTime').textContent = d.dateTime;

            document.getElementById('bdRental').textContent = d.rental;
            toggle('bdAddOnsRow', !!d.addonsSummary);
            document.getElementById('bdAddOnsSummary').textContent = d.addonsSummary || '';
            document.getElementById('bdAddOnsTotal').textContent = d.addonsTotal || '0';
            document.getElementById('bdTotal').textContent = d.total;

            document.getElementById('bdPaymentStatus').textContent = d.paymentStatus;
            toggle('bdMethodRow', !!d.method);
            document.getElementById('bdMethod').textContent = d.method || '';
            toggle('bdRefRow', !!d.reference);
            document.getElementById('bdReference').textContent = d.reference || '';

            toggle('bdProofRow', !!d.proof);
            if (d.proof) { document.getElementById('bdProofLink').href = d.proof; }

            document.getElementById('bdBookedBy').textContent = d.bookedBy;
            document.getElementById('bdCreated').textContent = d.created;

            document.getElementById('bdStatusId').value = d.id;
            document.getElementById('bdStatusSelect').value = d.status;
            document.getElementById('bdStatusForm').action = d.isOpenPlay === 'true'
                ? modalEl.dataset.updateSignupUrl
                : modalEl.dataset.updateBookingUrl;

            function toggle(id, show) {
                document.getElementById(id).classList.toggle('d-none', !show);
            }
        });

        document.getElementById('bdStatusForm').addEventListener('submit', function (e) {
            var id = document.getElementById('bdId').textContent;
            var status = document.getElementById('bdStatusSelect').value;
            if (!confirm('Change booking #' + id + ' status to ' + status + '?')) {
                e.preventDefault();
            }
        });
    })();
</script>
}
