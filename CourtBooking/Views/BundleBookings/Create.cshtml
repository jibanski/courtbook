@using CourtBooking.Models
@{
    ViewData["Title"] = "Book Bundle";
    var bundle    = ViewBag.Bundle as CourtBundle;
    var block     = ViewBag.Block as CourtBundleRateBlock;
    var price     = (decimal)ViewBag.Price;
    var startHour = (int)ViewBag.StartHour;
    var endHour   = (int)ViewBag.EndHour;
    var selectedCourt = ViewBag.SelectedCourt as Court;
    var date      = (DateOnly)ViewBag.Date;
    var available = (bool)ViewBag.Available;
    var courtNames = (selectedCourt is not null
            ? new List<string> { selectedCourt.Name }
            : bundle?.Courts
                .Select(c => c.Court.Name)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .ToList())
        ?? new List<string>();
    var bundledCourtsLabel = courtNames.Count switch
    {
        0 => "selected court(s)",
        1 => courtNames[0],
        _ => string.Join(", ", courtNames)
    };
    var courtLabels = courtNames.Any() ? courtNames : new List<string> { "selected court" };
}

<div class="cb-page-header">
    <div class="container">
        <h1 class="mb-1" style="font-size:1.75rem;">
            <i class="bi bi-box-seam me-2" style="color:var(--cb-lime);"></i>@bundle!.Name
        </h1>
        <p style="color:var(--cb-text-2);font-size:.9rem;margin:0;">Bundled booking — Court: @bundledCourtsLabel, one flat price</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger">@err</div>
            }

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-receipt me-2 text-primary"></i>Bundle Summary
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @for (int i = 0; i < courtLabels.Count; i++)
                        {
                            <div class="col-6 text-muted small">Court @(i + 1)</div>
                            <div class="col-6 fw-semibold">@courtLabels[i]</div>
                        }
                        <div class="col-6 text-muted small">Date</div>
                        <div class="col-6 fw-semibold">@date.ToString("MMMM d, yyyy")</div>
                        <div class="col-6 text-muted small">Time</div>
                        <div class="col-6 fw-semibold">@TimeDisplay.HourRange(startHour, endHour)</div>
                        @if (block is not null && startHour != block.StartHour)
                        {
                            <div class="col-12"><small class="text-muted">Shortened from the original @TimeDisplay.HourRange(block.StartHour, block.EndHour) window — the earlier part has already passed, so the price below is pro-rated.</small></div>
                        }
                        <div class="col-12"><hr class="my-2"></div>
                        <div class="col-6 fw-bold">Total Amount</div>
                        <div class="col-6 fw-bold text-success fs-5">₱@price.ToString("N0")</div>
                    </div>
                </div>
            </div>

            @if (!available)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    This court is unavailable for this window (booked, pending, or blocked). Please pick another date.
                </div>
            }
            else
            {
                <form asp-action="Create" method="post"
                      onsubmit="var b=this.querySelector('button[type=submit]'); if(b.disabled){return false;} b.disabled=true; b.innerHTML='<span class=&quot;spinner-border spinner-border-sm me-2&quot;></span>Booking...';">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bundleId" value="@bundle.Id" />
                    <input type="hidden" name="courtId" value="@selectedCourt?.Id" />
                    <input type="hidden" name="date" value="@date.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="startHour" value="@startHour" />
                    <input type="hidden" name="endHour" value="@endHour" />

                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <div class="border rounded-3 p-3 mb-3" style="background:var(--cb-surface-2, #f8f9fa);">
                            <h6 class="fw-bold mb-2"><i class="bi bi-person me-1"></i>Your Info</h6>
                            <p class="small text-muted mb-2">Booking as a guest — no account needed.</p>
                            <div class="mb-2">
                                <label class="form-label small fw-semibold">Name</label>
                                <input name="guestName" class="form-control" required />
                            </div>
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <label class="form-label small fw-semibold">Email</label>
                                    <input type="email" name="guestEmail" class="form-control" required />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small fw-semibold">Phone</label>
                                    <input type="tel" name="guestPhone" class="form-control" required />
                                </div>
                            </div>
                            <p class="small text-muted mt-2 mb-0">
                                Have an account? <a asp-controller="Account" asp-action="Login">Log in</a> to manage all your bookings in one place.
                            </p>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Notes <span class="text-muted small">(optional)</span></label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Any special requests..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Voucher Code <span class="text-muted small">(optional)</span></label>
                        <input name="voucherCode" class="form-control text-uppercase" placeholder="e.g. LOYAL10" maxlength="30" />
                    </div>
                    <button type="submit" class="btn btn-lg w-100 fw-bold" style="background:var(--cb-lime);color:#000;">
                        <i class="bi bi-calendar-plus me-2"></i>Book This Bundle — ₱@price.ToString("N0")
                    </button>
                </form>
            }

        </div>
    </div>
</div>
