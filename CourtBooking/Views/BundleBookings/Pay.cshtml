@model CourtBooking.Models.Booking
@{
    ViewData["Title"] = "Complete Payment";
    var settings       = ViewBag.Settings as CourtBooking.Models.FacilitySettings ?? new CourtBooking.Models.FacilitySettings();
    var combinedTotal  = (decimal)ViewBag.CombinedTotal;
    var courtNames     = (string)ViewBag.CourtNames;
    var groupId        = (Guid)ViewBag.GroupId;
    bool hasGCash   = !string.IsNullOrWhiteSpace(settings.GCashNumber);
    bool hasMaya    = !string.IsNullOrWhiteSpace(settings.MayaNumber);
    bool hasGoTyme  = !string.IsNullOrWhiteSpace(settings.GoTymeNumber);
    bool hasGCashQr = !string.IsNullOrWhiteSpace(settings.GCashQrCodePath);
    bool hasMayaQr  = !string.IsNullOrWhiteSpace(settings.MayaQrCodePath);
    bool hasGoTymeQr = !string.IsNullOrWhiteSpace(settings.GoTymeQrCodePath);

    Guid? guestToken = ViewBag.GuestToken as Guid?;
    bool isGuest = guestToken.HasValue;
    bool isAwaitingConfirm = Model.HasPaymentProof && Model.Status == CourtBooking.Models.BookingStatus.Pending;
    bool isConfirmed = Model.Status == CourtBooking.Models.BookingStatus.Confirmed;

    // Pre-populate Full Name: guests from CustomerNameSnapshot, auth users from ViewBag
    var customerFullName = Model.CustomerNameSnapshot ?? ViewBag.CustomerFullName as string;
}

<div class="cb-page-header">
    <div class="container">
        <div class="cb-fade-up">
            <h1 class="mb-1" style="font-size:1.75rem;">
                <i class="bi bi-credit-card me-2" style="color:var(--cb-lime);"></i>Complete Your Payment
            </h1>
            <p style="color:var(--cb-text-2);font-size:.9rem;margin:0;">Bundle booking — @courtNames</p>
        </div>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white fw-bold">
                    <i class="bi bi-receipt me-2 text-primary"></i>Booking Summary
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        @if (!string.IsNullOrWhiteSpace(settings.FacilityName) && settings.FacilityName != "CourtBook")
                        {
                            <div class="col-6 text-muted small">Facility</div>
                            <div class="col-6 fw-semibold">
                                <i class="bi bi-buildings me-1 text-primary"></i>@settings.FacilityName
                            </div>
                        }
                        <div class="col-6 text-muted small">Courts</div>
                        <div class="col-6 fw-semibold">@courtNames</div>
                        <div class="col-6 text-muted small">Date</div>
                        <div class="col-6 fw-semibold">@Model.BookingDate.ToString("MMMM d, yyyy")</div>
                        <div class="col-6 text-muted small">Time</div>
                        <div class="col-6 fw-semibold">@Model.StartTime.ToString("hh:mm tt") – @Model.EndTime.ToString("hh:mm tt")</div>
                        <div class="col-12"><hr class="my-2"></div>
                        <div class="col-6 fw-bold">Total Amount</div>
                        <div class="col-6 fw-bold text-success fs-5">₱@combinedTotal.ToString("N0")</div>
                    </div>
                </div>
            </div>

            @* ── Reservation Timer ── *@
            @if (!isConfirmed && Model.ReservedUntil.HasValue)
            {
                var remainSec = (int)Math.Max(0, (Model.ReservedUntil.Value - DateTime.UtcNow).TotalSeconds);
                var totalSec = 15 * 60;
                var initPct = (int)Math.Round((double)remainSec / totalSec * 100);
                var initDisplay = $"{remainSec / 60:D2}:{remainSec % 60:D2}";
                <div class="card shadow-sm mb-4" id="timerCard" style="border-left: 4px solid var(--cb-orange);">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div>
                                <i class="bi bi-hourglass-split fs-4" style="color:var(--cb-orange);"></i>
                            </div>
                            <div class="flex-grow-1">
                                <p class="mb-1 small fw-semibold text-muted">YOUR RESERVATION EXPIRES IN</p>
                                <div class="d-flex align-items-baseline gap-2">
                                    <span id="timerDisplay" class="fs-4 fw-bold" style="font-family:'Courier New',monospace;color:#dc3545;">@initDisplay</span>
                                    <span class="small text-muted">(minutes : seconds)</span>
                                </div>
                            </div>
                        </div>
                        <div class="progress mt-3" style="height: 6px;">
                            <div id="timerProgress" class="progress-bar bg-success" role="progressbar" style="width: @initPct%;" aria-valuenow="@initPct" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
                <script>
                    (function () {
                        let s = @remainSec;
                        const total = @totalSec;
                        function tick() {
                            const disp = document.getElementById('timerDisplay');
                            const card = document.getElementById('timerCard');
                            const bar  = document.getElementById('timerProgress');
                            if (!disp) return;
                            disp.textContent = String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
                            bar.style.width = Math.max(0, (s / total) * 100) + '%';
                            if (s <= 0) {
                                disp.style.color = '#dc3545'; card.style.borderLeftColor = '#dc3545'; bar.className = 'progress-bar bg-danger';
                                setTimeout(() => location.reload(), 2000);
                            } else if (s <= 180) {
                                disp.style.color = '#dc3545'; card.style.borderLeftColor = '#dc3545'; bar.className = 'progress-bar bg-danger';
                            } else if (s <= 300) {
                                disp.style.color = '#dc3545'; card.style.borderLeftColor = '#ffc107'; bar.className = 'progress-bar bg-warning';
                            } else {
                                disp.style.color = '#dc3545'; card.style.borderLeftColor = 'var(--cb-orange)'; bar.className = 'progress-bar bg-success';
                            }
                            if (s > 0) s--;
                        }
                        tick();
                        setInterval(tick, 1000);
                    })();
                </script>
            }

            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-exclamation-triangle-fill"></i> @err
                </div>
            }

            @if (isConfirmed)
            {
                <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-check-circle-fill fs-4"></i>
                    <div><strong>Payment confirmed!</strong> Your bundle booking is all set.</div>
                </div>
            }
            else if (isAwaitingConfirm)
            {
                <div class="alert alert-info d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-hourglass-split fs-4"></i>
                    <div><strong>Payment submitted</strong> — your bundle is reserved while the facility reviews it. You'll get an email once it's confirmed.</div>
                </div>
            }

            @if (!isConfirmed && !isAwaitingConfirm && !hasGCash && !hasMaya && !hasGoTyme)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Payment details have not been set up yet. Please contact the facility to arrange payment.
                </div>
            }
            else if (!isConfirmed && !isAwaitingConfirm)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white fw-bold">
                        <i class="bi bi-send me-2 text-success"></i>Send Payment To
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            @if (hasGCash)
                            {
                                <div class="col-sm-6">
                                    <div class="border rounded p-3 text-center bg-light h-100">
                                        <div class="fw-bold text-primary mb-2"><i class="bi bi-phone me-1"></i>GCash</div>
                                        @if (hasGCashQr)
                                        {
                                            <img src="@settings.GCashQrCodePath" alt="GCash QR Code" style="max-width:200px;width:100%;border-radius:8px;margin-bottom:.5rem;" />
                                        }
                                        <div class="fs-5 fw-bold">@settings.GCashNumber</div>
                                        @if (!string.IsNullOrWhiteSpace(settings.GCashName))
                                        {
                                            <div class="text-muted small">@settings.GCashName</div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (hasMaya)
                            {
                                <div class="col-sm-6">
                                    <div class="border rounded p-3 text-center bg-light h-100">
                                        <div class="fw-bold text-success mb-2"><i class="bi bi-phone me-1"></i>Maya</div>
                                        @if (hasMayaQr)
                                        {
                                            <img src="@settings.MayaQrCodePath" alt="Maya QR Code" style="max-width:200px;width:100%;border-radius:8px;margin-bottom:.5rem;" />
                                        }
                                        <div class="fs-5 fw-bold">@settings.MayaNumber</div>
                                        @if (!string.IsNullOrWhiteSpace(settings.MayaName))
                                        {
                                            <div class="text-muted small">@settings.MayaName</div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (hasGoTyme)
                            {
                                <div class="col-sm-6">
                                    <div class="border rounded p-3 text-center bg-light h-100">
                                        <div class="fw-bold text-info mb-2"><i class="bi bi-phone me-1"></i>GoTyme</div>
                                        @if (hasGoTymeQr)
                                        {
                                            <img src="@settings.GoTymeQrCodePath" alt="GoTyme QR Code" style="max-width:200px;width:100%;border-radius:8px;margin-bottom:.5rem;" />
                                        }
                                        <div class="fs-5 fw-bold">@settings.GoTymeNumber</div>
                                        @if (!string.IsNullOrWhiteSpace(settings.GoTymeName))
                                        {
                                            <div class="text-muted small">@settings.GoTymeName</div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(settings.PaymentInstructions))
                        {
                            <div class="alert alert-info mt-3 py-2 mb-0 small">
                                <i class="bi bi-info-circle me-1"></i>@settings.PaymentInstructions
                            </div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white fw-bold">
                        <i class="bi bi-check2-circle me-2 text-primary"></i>Submit Payment Proof
                    </div>
                    <div class="card-body">
                        <form asp-action="@(isGuest ? "GuestSubmitProof" : "SubmitProof")" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            @if (isGuest)
                            {
                                <input type="hidden" name="token" value="@guestToken" />
                            }
                            else
                            {
                                <input type="hidden" name="groupId" value="@groupId" />
                            }

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                                <input type="text" name="fullName" class="form-control" value="@customerFullName"
                                       placeholder="Your full name" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Payment Method</label>
                                <select name="method" class="form-select" required>
                                    @if (hasGCash) { <option value="GCash">GCash</option> }
                                    @if (hasMaya)  { <option value="Maya">Maya</option> }
                                    @if (hasGoTyme) { <option value="GoTyme">GoTyme</option> }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Transaction / Reference Number <span class="text-muted small">(optional)</span></label>
                                <input type="text" name="reference" class="form-control" placeholder="e.g. 1234567890" maxlength="100" />
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-semibold">Screenshot <span class="text-danger">*</span></label>
                                <input type="file" name="screenshot" class="form-control" accept=".jpg,.jpeg,.png,.webp" required />
                                <div class="form-text">Upload a screenshot of your payment confirmation (JPG, PNG, or WebP).</div>
                            </div>
                            <button type="submit" class="btn btn-success btn-lg w-100">
                                <i class="bi bi-check-circle me-2"></i>Submit Payment Proof
                            </button>
                        </form>
                    </div>
                </div>
            }

            @if (isGuest)
            {
                @if (!isConfirmed && Model.BookingDate > PhtClock.Today)
                {
                    <form asp-action="GuestCancel" method="post" onsubmit="return confirm('Cancel this bundle booking?')" class="mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="token" value="@guestToken" />
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                            <i class="bi bi-x-circle me-1"></i>Cancel Booking
                        </button>
                    </form>
                }
                <p class="text-center text-muted small">
                    <i class="bi bi-envelope me-1"></i>Bookmark this page or check your email to come back later.
                </p>
            }
            else
            {
                <div class="text-center">
                    <a asp-controller="Bookings" asp-action="My" class="btn btn-link text-muted">
                        <i class="bi bi-arrow-left me-1"></i>Back to My Bookings
                    </a>
                </div>
            }
        </div>
    </div>
</div>
