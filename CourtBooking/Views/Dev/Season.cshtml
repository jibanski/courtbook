@using CourtBooking.Models
@using CourtBooking.Services
@{
    Layout = null;
    ViewData["Title"] = "CourtBook — Seasonal Theme";

    var password   = ViewBag.Password  as string ?? "";
    var errorMsg   = ViewBag.Error     as string;
    var isUnlocked = (bool)(ViewBag.IsUnlocked ?? false);
    var cfg        = ViewBag.Config    as PlatformConfig;
    var active     = cfg?.ActiveSeason;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body                          { background:#0d1117; color:#e6edf3; }
        .dev-card                     { background:#161b22; border:1px solid #30363d; border-radius:12px; }
        .form-control                 { background:#0d1117; border-color:#30363d; color:#e6edf3; }
        .form-control:focus           { background:#0d1117; border-color:#58a6ff; color:#e6edf3; box-shadow:none; }
        .nav-link                     { color:#58a6ff !important; font-size:.85rem; }
    </style>
</head>
<body>
<div class="container py-5" style="max-width:640px;">

    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 rounded-circle mb-3"
             style="width:64px;height:64px;">
            <i class="bi bi-snow2 text-warning fs-2"></i>
        </div>
        <h3 class="fw-bold mb-1">Seasonal Theme</h3>
        <p class="text-secondary small mb-0">Switch the site-wide seasonal look on or off. Applies to every page within a few seconds.</p>
        <div class="mt-1">
            <a href="/Dev/Facilities" class="nav-link d-inline-block">Facilities</a>
            <span class="text-secondary mx-1">·</span>
            <a href="/Dev/Subscriptions" class="nav-link d-inline-block">Subscriptions</a>
            <span class="text-secondary mx-1">·</span>
            <a href="/Dev/Reviews" class="nav-link d-inline-block">Reviews</a>
            <span class="text-secondary mx-1">·</span>
            <a href="/Dev/KeyGen" class="nav-link d-inline-block">Key Generator</a>
            <span class="text-secondary mx-1">·</span>
            <a href="/Dev/DonationQr" class="nav-link d-inline-block">Donation QR</a>
            <span class="text-secondary mx-1">·</span>
            <a href="/Dev/Logo" class="nav-link d-inline-block">Platform Logo</a>
        </div>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-check-circle-fill"></i> @ok
        </div>
    }
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMsg
        </div>
    }

    @if (!isUnlocked)
    {
        <div class="dev-card p-4">
            <form method="post" asp-action="Season" asp-controller="Dev">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label fw-semibold small text-secondary">
                        <i class="bi bi-shield-lock me-1"></i>Developer Password
                    </label>
                    <input type="password" name="password" class="form-control"
                           placeholder="Enter developer password" autofocus required />
                </div>
                <button type="submit" class="btn btn-warning w-100 fw-semibold text-dark">
                    <i class="bi bi-unlock me-2"></i>Unlock
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="dev-card p-4">
            <div class="mb-3 small text-secondary">
                Current:
                @if (string.IsNullOrEmpty(active))
                {
                    <span class="text-light fw-semibold">Default (no seasonal theme)</span>
                }
                else
                {
                    var cur = SeasonTheme.All.FirstOrDefault(s => s.Key == active);
                    <span class="text-warning fw-semibold">@cur.Emoji @cur.Label</span>
                }
            </div>

            <form method="post" asp-action="Season" asp-controller="Dev" class="d-grid gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="password" value="@password" />

                @foreach (var s in SeasonTheme.All)
                {
                    <button type="submit" name="season" value="@s.Key"
                            class="btn @(active == s.Key ? "btn-warning text-dark" : "btn-outline-light") fw-semibold py-2">
                        @s.Emoji @s.Label @(active == s.Key ? "(active)" : "")
                    </button>
                }
                <button type="submit" name="season" value="off"
                        class="btn @(string.IsNullOrEmpty(active) ? "btn-secondary" : "btn-outline-secondary") fw-semibold py-2">
                    <i class="bi bi-slash-circle me-1"></i>Off (default look)
                </button>
            </form>
        </div>
    }

</div>
</body>
</html>
