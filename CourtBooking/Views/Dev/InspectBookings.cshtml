@{
    Layout = null;   // Standalone page — no nav, no branding
    ViewData["Title"] = "CourtBook — Raw Booking Inspector";

    var errorMsg = ViewBag.Error as string;
    var search   = ViewBag.Search as string ?? "";
    var rows     = ViewBag.Rows as List<CourtBooking.Controllers.DevController.RawBookingRow>;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #0d1117; color: #e6edf3; }
        .dev-card { background: #161b22; border: 1px solid #30363d; border-radius: 12px; }
        .form-control { background: #0d1117; border-color: #30363d; color: #e6edf3; }
        .form-control:focus { background: #0d1117; border-color: #58a6ff; color: #e6edf3; box-shadow: none; }
        table { font-size: .85rem; }
        th { color: #8b949e; font-weight: 600; text-transform: uppercase; font-size: .7rem; }
        td, th { border-color: #30363d !important; }
    </style>
</head>
<body>
<div class="container py-5" style="max-width: 1100px;">

    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10
                    rounded-circle mb-3" style="width:64px;height:64px;">
            <i class="bi bi-search text-primary fs-2"></i>
        </div>
        <h3 class="fw-bold mb-1">Raw Booking Inspector</h3>
        <p class="text-secondary small mb-0">
            Every matching `Booking` row straight from the DB — no date/status filters, no view-level logic.
        </p>
        <a href="/Dev/Facilities" class="small mt-1 d-inline-block" style="color:#58a6ff;">
            <i class="bi bi-buildings me-1"></i>Switch to Facility Management
        </a>
    </div>

    @if (!string.IsNullOrEmpty(errorMsg))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i> @errorMsg
        </div>
    }

    <div class="dev-card p-4 mb-4">
        <form method="post" asp-action="InspectBookings" asp-controller="Dev" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <input type="password" name="password" class="form-control" style="max-width:220px;"
                   placeholder="Developer password" autocomplete="current-password" required />
            <input type="text" name="search" value="@search" class="form-control"
                   placeholder="Customer name or phone number" required />
            <button type="submit" class="btn btn-primary text-nowrap">
                <i class="bi bi-search me-1"></i>Search
            </button>
        </form>
    </div>

    @if (rows != null)
    {
        <div class="dev-card p-3">
            <p class="text-secondary small mb-3">@rows.Count row(s) found for "@search" — sorted oldest to newest by CreatedAt.</p>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Id</th><th>Court</th><th>Booking Date</th><th>Time</th>
                            <th>Status</th><th>Created At (UTC)</th><th>Logged By</th>
                            <th>Payment</th><th>Total</th><th>Customer</th><th>Phone</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rows)
                        {
                            <tr>
                                <td>#@r.Id</td>
                                <td>@r.CourtName</td>
                                <td>@r.BookingDate.ToString("MMM d, yyyy")</td>
                                <td>@r.StartTime.ToString("h:mm tt")&ndash;@r.EndTime.ToString("h:mm tt")</td>
                                <td>
                                    <span class="badge @(r.Status == CourtBooking.Models.BookingStatus.Cancelled ? "bg-danger" : r.Status == CourtBooking.Models.BookingStatus.Confirmed ? "bg-success" : "bg-secondary")">
                                        @r.Status
                                    </span>
                                </td>
                                <td class="font-monospace">@r.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@(r.LoggedByStaffName ?? "—") <div class="text-secondary" style="font-size:.7rem;">@r.LoggedByStaffId</div></td>
                                <td>@(r.PaymentMethod ?? "—")</td>
                                <td>&#8369;@r.TotalPrice.ToString("N0")</td>
                                <td>@r.CustomerName</td>
                                <td>@r.Phone</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
</body>
</html>
